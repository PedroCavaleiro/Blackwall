POSTGRES__CONNECTION_STRING=
REDIS__CONNECTION_STRING=
ENABLE_DOCS=false

# Discord OAuth + Bot
DISCORD__BOT_TOKEN=
DISCORD__CLIENT_ID=
DISCORD__CLIENT_SECRET=
DISCORD__REDIRECT_URI=
# Minimum permissions: VIEW_CHANNEL + SEND_MESSAGES + MANAGE_MESSAGES + READ_MESSAGE_HISTORY
DISCORD__BOT_PERMISSIONS=10308992462014
DISCORD__BOT_SCOPES=bot applications.commands
DISCORD__LOGIN_SCOPES=identify guilds

# Twitch OAuth
TWITCH__CLIENT_ID=
TWITCH__CLIENT_SECRET=
TWITCH__REDIRECT_URI=
TWITCH__LOGIN_SCOPES=openid user:read:email
# Scopes requested when a channel owner installs the bot on their channel
TWITCH__BOT_SCOPES=chat:read chat:edit channel:moderate channel:read:subscriptions moderation:read openid channel:manage:redemptions channel:read:editors moderator:manage:automod moderator:read:automod_settings moderator:manage:automod_settings moderator:manage:banned_users moderator:read:blocked_terms moderator:manage:blocked_terms moderator:read:chat_settings moderator:manage:chat_settings moderator:manage:chat_messages channel:manage:moderators channel:read:vips channel:manage:vips moderator:read:chatters moderator:read:shield_mode moderator:manage:shield_mode moderator:read:shoutouts moderator:manage:shoutouts moderator:read:followers channel:bot user:read:chat moderator:read:unban_requests moderator:manage:unban_requests moderator:read:suspicious_users moderator:manage:warnings moderator:read:banned_users moderator:read:chat_messages moderator:read:moderators moderator:manage:suspicious_users moderator:read:vips moderator:read:warnings
TWITCH__BOT_REDIRECT_URI=
# Dedicated bot account for IRC chat and moderation API calls.
# Create a separate Twitch account (e.g. "BlackwallBot"), then generate OAuth tokens.
# Generate tokens at: https://twitchtokengenerator.com/
#   1. Log in with your BOT ACCOUNT credentials (not your main account)
#   2. Select the "Helix" token type
#   3. Select these scopes: chat:read, chat:edit
#   4. Click "Generate Token" — you'll get an access token and a refresh token
#   5. Copy BOTH the access token and refresh token
# The access token should NOT include the "oauth:" prefix here.
# The bot account must be added as a moderator (/mod BlackwallBot) in each channel.
# The refresh token enables auto-renewal — without it, the access token expires in ~4 hours.
# If left empty, the bot falls back to connecting as the channel owner (not recommended).
TWITCH__BOT_USERNAME=
TWITCH__BOT_ACCESS_TOKEN=
TWITCH__BOT_REFRESH_TOKEN=

SAFE_BROWSING__ENABLED=false
SAFE_BROWSING__API_KEY=
SAFE_BROWSING__BASE_URL=https://safebrowsing.googleapis.com/v5

# JWT - must match between API and Web
JWT__ISSUER=Api
JWT__AUDIENCE=Web
JWT__SECRET=

# AES encryption for stored OAuth tokens (Discord and Twitch)
APP__ENC_KEY=
APP__ENC_IV=
APP__DISABLE_NEW_USERS=false
APP__PRIVATE_INSTANCE=false
APP__INSTANCE_OWNER=
APP__AI_SENTINEL_ENABLED=true

# Web project only - base URL of Blackwall.Api
API__BASE_URL=https://localhost:7001
API__PORT=7001
API__PROTECTION_ENABLED=true
API__KEY=

# Web redirect target - base URL of Blackwall.Web
WEB__BASEURL=https://localhost:7002
WEB__PORT=7002

# Guild permission sync background service
GUILD_SYNC__ENABLED=true
GUILD_SYNC__INTERVAL_MINUTES=15