@page "/"
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IOptions<AppConfiguration> AppCfg

<PageTitle>Blackwall — Discord Anti-Spam</PageTitle>

<div class="d-flex flex-column" style="min-height:calc(100vh - 64px)">
    <main class="flex-grow-1">

        <!-- Hero -->
        <section class="text-center" style="padding:5rem 1.5rem 4rem;position:relative;overflow:hidden">
            <div style="position:absolute;top:1rem;left:50%;transform:translateX(-50%);width:520px;height:520px;border-radius:50%;background:var(--bw-primary);opacity:0.06;filter:blur(90px);pointer-events:none"></div>

            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-4 font-mono"
                 style="border:1px solid rgba(34,211,238,0.4);color:var(--bw-primary);font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;position:relative">
                <span class="rounded-circle bw-pulse" style="width:6px;height:6px;background:var(--bw-primary);flex-shrink:0;display:inline-block"></span>
                System online &middot; protecting Discord servers
            </div>

            <h1 class="font-display mb-3" style="font-size:clamp(2.2rem,5.5vw,4.2rem);line-height:1.1;position:relative">
                Blocks rogue threats<br/>
                <span class="neon-text">like the barrier</span> itself.
            </h1>

            <p class="mx-auto mb-5 font-mono" style="max-width:580px;color:var(--bw-muted);font-size:0.92rem;line-height:1.7;position:relative">
                Blackwall is an autonomous countermeasure for Discord — spam scoring,
                raid detection, and automated enforcement when something nasty tries to breach your server.
            </p>

            @if (_error == "new_users_disabled") {
                <div class="bw-warning d-inline-block mb-4 font-mono">
                    // ACCESS DENIED: New user registration is currently disabled.
                </div>
            } else if (_error == "not_allowed") {
                <div class="bw-warning d-inline-block mb-4 font-mono">
                    // ACCESS DENIED: You are not authorized to join this instance.
                </div>
            } else if (!string.IsNullOrEmpty(_error)) {
                <div class="bw-error d-inline-block mb-4 font-mono">
                    // AUTH ERROR: Authentication failed. Please try again.
                </div>
            }

            <div style="position:relative">
                <button type="button" class="btn btn-primary btn-lg cut-corner font-display"
                        style="letter-spacing:0.12em;padding:0.75rem 2.5rem"
                        @onclick="ToggleLoginModal">
                    DEPLOY BLACKWALL
                </button>
            </div>
        </section>

        <!-- Implemented functionalities -->
        <section style="padding:0 1.5rem 5rem;max-width:1000px;margin:0 auto">
            <div class="text-center mb-5">
                <h2 class="font-display mb-2" style="font-size:1.1rem;letter-spacing:0.15em;color:var(--bw-primary)">
                    ACTIVE SUBROUTINES
                </h2>
                <p class="font-mono mb-0" style="font-size:0.78rem;color:var(--bw-muted)">
                    // Every module below is deployed and operational.
                </p>
            </div>
            <div class="row g-3">
                @foreach (var f in Features) {
                    <div class="col-md-4">
                        <div class="cut-corner border h-100 p-4" style="background:var(--bs-card-bg);position:relative">
                            <div style="position:absolute;top:0;left:0;width:3rem;height:1px;background:var(--bw-primary)"></div>
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <i class="@f.Icon" style="color:var(--bw-primary);font-size:1.4rem"></i>
                                @if (f.IsOptional && !AppCfg.Value.AiSentinelEnabled) {
                                    <span class="font-mono d-inline-flex align-items-center gap-1" style="font-size:0.55rem;letter-spacing:0.1em;color:var(--bw-muted);border:1px solid rgba(139,148,158,0.3);padding:0.1rem 0.4rem;opacity:0.7">
                                        <span class="rounded-circle" style="width:5px;height:5px;background:var(--bw-muted);flex-shrink:0;display:inline-block"></span>
                                        DISABLED
                                    </span>
                                } else {
                                    <span class="font-mono d-inline-flex align-items-center gap-1" style="font-size:0.55rem;letter-spacing:0.1em;color:var(--bw-primary);border:1px solid rgba(34,211,238,0.3);padding:0.1rem 0.4rem">
                                        <span class="rounded-circle bw-pulse" style="width:5px;height:5px;background:var(--bw-primary);flex-shrink:0;display:inline-block"></span>
                                        ACTIVE
                                    </span>
                                }
                            </div>
                            <h3 class="font-display mb-2" style="font-size:0.9rem;letter-spacing:0.08em">@f.Title</h3>
                            <p class="font-mono mb-0" style="font-size:0.78rem;color:var(--bw-muted);line-height:1.6">@f.Desc</p>
                        </div>
                    </div>
                }
            </div>
        </section>
    </main>

    <footer style="border-top:1px solid rgba(34,211,238,0.12);padding:1.5rem">
        <div class="bw-container d-flex align-items-center justify-content-between">
            <span class="font-mono bw-meta">
                BLACKWALL.SYS // v1.0.0
            </span>
            <div class="d-flex align-items-center gap-3">
                <a href="https://github.com/PedroCavaleiro/Blackwall" target="_blank" class="font-mono text-decoration-none bw-meta">GitHub</a>
                <a href="/terms-of-service" class="font-mono text-decoration-none bw-meta">Terms</a>
                <a href="/privacy-policy" class="font-mono text-decoration-none bw-meta">Privacy</a>
                <span class="font-mono bw-meta">NOT AFFILIATED WITH DISCORD INC.</span>
            </div>
        </div>
    </footer>
</div>

@if (_loginModalOpen) {
    <LoginModal OnClose="CloseLoginModal" />
}

@code {
    private string? _error;
    private bool _loginModalOpen;

    private void ToggleLoginModal() => _loginModalOpen = true;

    private void CloseLoginModal() => _loginModalOpen = false;

    private static readonly (string Icon, string Title, string Desc, bool IsOptional)[] Features = [
        ("fa-solid fa-bolt", "Spam Detection", "Rolling-window rate limiting, invite-link blocking, and suspicious-URL detection with redirect following. Tunable per-server thresholds.", false),
        ("fa-solid fa-triangle-exclamation", "Raid Detection", "Monitors join velocity in real time. Triggers automatic lockdown when configurable join-rate thresholds are breached.", false),
        ("fa-solid fa-globe", "Safe Browsing", "Real-time URL checks against Google Safe Browsing V5 using hash-prefix lookups with Rice-Golomb delta decoding and Redis caching.", false),
        ("fa-solid fa-ban", "Domain Blacklist", "Downloads and caches AdGuard-format domain filter lists in Redis. Messages containing blacklisted domains are blocked instantly.", false),
        ("fa-solid fa-user-shield", "Account Scoring", "Scores new members on account age, avatar presence, and username patterns (gibberish, numeric-only, consecutive consonants). Flags suspicious accounts.", false),
        ("fa-solid fa-robot", "Bot Allowlist", "Only explicitly trusted bots bypass spam detection. Automated attacks disguised as bot accounts are caught and processed through the full filter pipeline.", false),
        ("fa-solid fa-lock", "Lockdown Protocol", "Denies SEND_MESSAGES, SEND_MESSAGES_IN_THREADS, and CREATE_PUBLIC_THREADS for @everyone across all text channels when a raid is detected.", false),
        ("fa-solid fa-clipboard-list", "Ban Synchronization", "Periodically syncs Discord guild ban lists into the database so enforcement state stays consistent across restarts.", false),
        ("fa-solid fa-gears", "Permission Sync", "Tracks guild-level bot permissions and role changes to ensure Blackwall always has the access it needs to enforce.", false),
        ("fa-solid fa-shield-halved", "Content Guard", "Banned word filtering with Levenshtein fuzzy matching and leetspeak normalisation, Zalgo text blocking, copypasta hash detection, and invisible character scrubbing.", false),
        ("fa-solid fa-bullseye", "NetWatchSnare", "Trap channels that automatically punish users who post in them. Configurable per-trap actions — useful for announcement channels and decoy bot-catchers.", false),
        ("fa-solid fa-brain", "AI Sentinel (Optional)", "AI-powered content moderation as the last pipeline step. Supports OpenAI, Anthropic, Gemini, and Ollama. Off by default — must be enabled per guild.", true),
    ];

    protected override async Task OnInitializedAsync() {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (query.Contains("error=")) {
            var match = System.Text.RegularExpressions.Regex.Match(query, @"[?&]error=([^&]*)");
            _error = match.Success ? Uri.UnescapeDataString(match.Groups[1].Value) : "auth_failed";
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo("/dashboard", replace: true);
    }
}