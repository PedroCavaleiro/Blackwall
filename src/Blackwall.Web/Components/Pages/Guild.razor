@page "/guild/{DiscordGuildId:long}"
@attribute [Authorize]
@rendermode InteractiveServer
@using Blackwall.Core.Entities
@inject BlackwallApiService Api
@inject NavigationManager Nav

<PageTitle>@(_settings?.Name ?? "Config") — Blackwall</PageTitle>

<div style="max-width:760px;margin:0 auto;padding:2.5rem 1.5rem">
    @if (_loading) {
        <div class="font-mono" style="color:var(--bw-muted);font-size:0.85rem">&gt; Loading configuration...</div>
    } else if (_settings is null) {
        <div class="font-mono mb-4" style="color:var(--bw-danger);font-size:0.85rem">&gt; SIGNAL LOST: Guild not found or access denied.</div>
        <a href="/dashboard" class="btn btn-primary cut-corner font-display" style="font-size:0.72rem">RETURN TO GRID</a>
    } else {
        <a href="/dashboard" class="d-inline-flex align-items-center gap-2 mb-4 font-mono text-decoration-none"
           style="font-size:0.68rem;letter-spacing:0.12em;color:var(--bw-muted)">
            &#8592; BACK TO GRID
        </a>

        <div class="d-flex align-items-center gap-3 mb-5">
            <GuildAvatar Name="@_settings.Name" Icon="@_settings.IconHash" GuildId="@_settings.DiscordGuildId" />
            <div>
                <div class="font-mono mb-1" style="font-size:0.65rem;letter-spacing:0.15em;color:var(--bw-primary)">
                    // GUILD CONFIG &middot; @_settings.DiscordGuildId
                </div>
                <h1 class="font-display mb-0" style="font-size:1.8rem;letter-spacing:0.04em">@_settings.Name.ToUpperInvariant()</h1>
                <div class="font-mono mt-1" style="font-size:0.68rem;color:var(--bw-muted)">
                    @(_settings.IsActive ? "BARRIER ACTIVE" : "BARRIER OFFLINE")
                </div>
            </div>
        </div>

        @if (_saved) {
            <div class="alert alert-success font-mono mb-4" style="font-size:0.8rem">
                // CONFIGURATION UPLOADED SUCCESSFULLY
            </div>
        }
        @if (_error is not null) {
            <div class="alert alert-danger font-mono mb-4" style="font-size:0.8rem">
                // ERROR: @_error
            </div>
        }

        <EditForm Model="Form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                <div class="card-header">BARRIER CONTROL</div>
                <div class="p-4">
                    <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Master controls for barrier activation and enforcement mode.</p>

                    <div class="bw-field">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Enable barrier</div>
                            <div class="form-text">When off, the bot will not process any messages in this server.</div>
                        </div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="isEnabled" @bind-Value="Form.IsEnabled" style="width:2.5em;height:1.3em" />
                        </div>
                    </div>
                    <div class="bw-field">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Dry run</div>
                            <div class="form-text">Detections are logged but no action is taken against the user.</div>
                        </div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="isDryRun" @bind-Value="Form.IsDryRun" style="width:2.5em;height:1.3em" />
                        </div>
                    </div>
                    <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Infraction action</div>
                            <div class="form-text">What the bot does to an offending user when a violation is detected.</div>
                        </div>
                        <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.Action">
                            <option value="@InfractionAction.DeleteOnly">Delete message only</option>
                            <option value="@InfractionAction.Timeout">Timeout user</option>
                            <option value="@InfractionAction.Kick">Kick user</option>
                            <option value="@InfractionAction.Ban">Ban user</option>
                        </InputSelect>
                    </div>
                </div>
            </div>

            @if (Form.Action is InfractionAction.Kick or InfractionAction.Ban) {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">MESSAGE PURGE</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Configure how far back Discord should delete the user's messages when they are kicked or banned.</p>

                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Delete messages (days)</div>
                                <div class="form-text">Number of days of message history to purge. Maximum is 7 days.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.MessageDeleteDays" />
                        </div>
                    </div>
                </div>
            }

            <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                <div class="card-header">DETECTION MATRIX</div>
                <div class="p-4">
                    <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Tune the parameters that trip the barrier.</p>

                    <div class="bw-field">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Rate limit window (seconds)</div>
                            <div class="form-text">Time window for the spam counter.</div>
                        </div>
                        <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.RateLimitWindowSeconds" />
                    </div>
                    <div class="bw-field">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Max messages per window</div>
                            <div class="form-text">Messages allowed per user before the barrier trips.</div>
                        </div>
                        <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.MaxMessagesPerWindow" />
                    </div>
                    <div class="bw-field">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Duplicate threshold</div>
                            <div class="form-text">Delete after this many identical copies in the window.</div>
                        </div>
                        <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.DuplicateMessageThreshold" />
                    </div>
                    <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Mention limit</div>
                            <div class="form-text">Max user/role pings allowed per message.</div>
                        </div>
                        <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.MentionLimit" />
                    </div>
                </div>
            </div>

            <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                <div class="card-header">LINK BLOCKING</div>
                <div class="p-4">
                    <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Configure which external vectors are neutralized automatically.</p>

                    <div class="bw-field">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Block Discord invite links</div>
                            <div class="form-text">Deletes messages containing discord.gg invite URLs.</div>
                        </div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="blockInvites" @bind-Value="Form.BlockInviteLinks" style="width:2.5em;height:1.3em" />
                        </div>
                    </div>
                    <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Block external links</div>
                            <div class="form-text">Deletes messages with URLs outside Discord's own domains.</div>
                        </div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="blockSuspicious" @bind-Value="Form.BlockSuspiciousLinks" style="width:2.5em;height:1.3em" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="cut-corner border mb-5" style="background:var(--bs-card-bg)">
                <div class="card-header">AUDIT LOG</div>
                <div class="p-4">
                    <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                        Select a channel where Blackwall will post an embed for each infraction: who triggered it, which filter fired, the message content, and the action taken.
                    </p>

                    <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                        <div class="bw-field-label">
                            <div class="form-label mb-1">Log channel</div>
                            <div class="form-text">Leave blank to disable audit logging.</div>
                        </div>
                        <InputSelect class="form-select" style="max-width:260px" @bind-Value="Form.LogChannelId">
                            <option value="">— None —</option>
                            @foreach (var ch in _channels) {
                                <option value="@ch.Id">#@ch.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button type="submit" class="btn btn-primary cut-corner font-display" style="font-size:0.75rem;letter-spacing:0.1em">
                    COMMIT CHANGES
                </button>
                <a href="/dashboard" class="btn btn-outline-secondary font-display" style="font-size:0.75rem;letter-spacing:0.1em">
                    CANCEL
                </a>
            </div>
        </EditForm>

        <hr style="border-color:var(--bw-danger);opacity:0.25;margin:3rem 0 2rem" />

        <div class="cut-corner border mb-4" style="background:var(--bs-card-bg);border-color:var(--bw-danger) !important">
            <div class="card-header" style="color:var(--bw-danger)">DANGER ZONE</div>
            <div class="p-4">
                <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                    Removing the bot will immediately kick it from your Discord server and deactivate this Blackwall instance. Your configuration will be preserved if you re-add the bot later.
                </p>

                @if (!_confirmRemove) {
                    <button type="button" class="btn btn-outline-danger cut-corner font-display"
                            style="font-size:0.75rem;letter-spacing:0.1em"
                            @onclick="() => _confirmRemove = true">
                        REMOVE BOT FROM SERVER
                    </button>
                } else {
                    <div class="font-mono mb-3" style="font-size:0.8rem;color:var(--bw-danger)">
                        // WARNING: This will kick the bot from @_settings.Name. Are you sure?
                    </div>
                    <div class="d-flex gap-3">
                        <button type="button" class="btn btn-danger cut-corner font-display"
                                style="font-size:0.75rem;letter-spacing:0.1em"
                                disabled="@_removing"
                                @onclick="RemoveBotAsync">
                            @(_removing ? "REMOVING..." : "CONFIRM REMOVAL")
                        </button>
                        <button type="button" class="btn btn-outline-secondary font-display"
                                style="font-size:0.75rem;letter-spacing:0.1em"
                                @onclick="() => _confirmRemove = false">
                            ABORT
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long DiscordGuildId { get; set; }

    private SpamConfigForm Form { get; set; } = new();

    private GuildSettingsResponse? _settings;
    private IReadOnlyList<DiscordChannelDto> _channels = [];
    private bool _loading = true;
    private bool _saved;
    private string? _error;
    private bool _confirmRemove;
    private bool _removing;

    protected override async Task OnInitializedAsync() {
        try {
            _settings = await Api.GetGuildSettingsAsync(DiscordGuildId);
            _channels = await Api.GetChannelsAsync(DiscordGuildId);

            if (_settings is not null) {
                var s = _settings.SpamConfiguration;
                Form.MaxMessagesPerWindow = s.MaxMessagesPerWindow;
                Form.RateLimitWindowSeconds = s.RateLimitWindowSeconds;
                Form.DuplicateMessageThreshold = s.DuplicateMessageThreshold;
                Form.MentionLimit = s.MentionLimit;
                Form.BlockInviteLinks = s.BlockInviteLinks;
                Form.BlockSuspiciousLinks = s.BlockSuspiciousLinks;
                Form.IsEnabled = s.IsEnabled;
                Form.IsDryRun = s.IsDryRun;
                Form.Action = s.Action;
                Form.LogChannelId = s.LogChannelId.HasValue ? s.LogChannelId.Value.ToString() : "";
                Form.MessageDeleteDays = s.MessageDeleteDays;
            }
        } catch {
            _settings = null;
        } finally {
            _loading = false;
        }
    }

    private async Task SaveAsync() {
        _saved = false;
        _error = null;

        try {
            long? logChannelId = long.TryParse(Form.LogChannelId, out var parsed) ? parsed : null;

            await Api.UpdateGuildSettingsAsync(DiscordGuildId, new UpdateGuildSettingsRequest(
                Form.MaxMessagesPerWindow,
                Form.RateLimitWindowSeconds,
                Form.DuplicateMessageThreshold,
                Form.MentionLimit,
                Form.BlockInviteLinks,
                Form.BlockSuspiciousLinks,
                Form.IsEnabled,
                Form.IsDryRun,
                Form.Action,
                logChannelId,
                Math.Clamp(Form.MessageDeleteDays, 0, 7)
            ));
            _saved = true;
            _settings = await Api.GetGuildSettingsAsync(DiscordGuildId);
        } catch (Exception ex) {
            _error = $"Failed to save settings: {ex.Message}";
        }
    }

    private async Task RemoveBotAsync() {
        _removing = true;
        _error = null;

        try {
            await Api.RemoveBotAsync(DiscordGuildId);
            Nav.NavigateTo("/dashboard", forceLoad: true);
        } catch (Exception ex) {
            _error = $"Failed to remove bot: {ex.Message}";
            _confirmRemove = false;
        } finally {
            _removing = false;
        }
    }

    private sealed class SpamConfigForm {
        public int MaxMessagesPerWindow { get; set; } = 5;
        public int RateLimitWindowSeconds { get; set; } = 5;
        public int DuplicateMessageThreshold { get; set; } = 3;
        public int MentionLimit { get; set; } = 5;
        public bool BlockInviteLinks { get; set; } = true;
        public bool BlockSuspiciousLinks { get; set; }
        public bool IsEnabled { get; set; } = true;
        public bool IsDryRun { get; set; }
        public InfractionAction Action { get; set; } = InfractionAction.DeleteOnly;
        public string LogChannelId { get; set; } = "";
        public int MessageDeleteDays { get; set; }
    }
}
