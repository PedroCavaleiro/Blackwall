@page "/guild/{DiscordGuildId:long}"
@attribute [Authorize]
@rendermode InteractiveServer
@using Blackwall.Core.Entities
@inject BlackwallApiService Api
@inject NavigationManager Nav

<PageTitle>@(_settings?.Name ?? "Config") — Blackwall</PageTitle>

<div style="max-width:980px;margin:0 auto;padding:2.5rem 1.5rem">
    @if (_loading) {
        <div class="font-mono bw-loading">&gt; Loading configuration...</div>
    } else if (_settings is null) {
        <div class="font-mono mb-4 bw-err">&gt; SIGNAL LOST: Guild not found or access denied.</div>
        <a href="/dashboard" class="btn btn-primary cut-corner font-display bw-btn-sm">RETURN TO GRID</a>
    } else {
        <a href="/dashboard" class="d-inline-flex align-items-center gap-2 mb-4 font-mono text-decoration-none bw-status bw-text-muted">
            &#8592; BACK TO GRID
        </a>

        <div class="d-flex align-items-center gap-3 mb-5">
            <GuildAvatar Name="@_settings.Name" Icon="@_settings.IconHash" GuildId="@_settings.DiscordGuildId" />
            <div>
                <div class="font-mono mb-1 bw-role bw-text-primary">
                    // GUILD CONFIG &middot; @_settings.DiscordGuildId
                </div>
                <h1 class="font-display mb-0" style="font-size:1.8rem;letter-spacing:0.04em">@_settings.Name.ToUpperInvariant()</h1>
                <div class="font-mono mt-1 bw-meta">
                    @(_settings.IsActive ? "BARRIER ACTIVE" : "BARRIER OFFLINE")
                </div>
            </div>
        </div>

        @if (_saved) {
            <div class="alert alert-success font-mono mb-4 bw-alert-text">
                // CONFIGURATION UPLOADED SUCCESSFULLY
            </div>
        }
        @if (_error is not null) {
            <div class="alert alert-danger font-mono mb-4 bw-alert-text">
                // ERROR: @_error
            </div>
        }
        @if (string.IsNullOrWhiteSpace(Form.LogChannelId)) {
            <div class="bw-warning font-mono mb-4">
                // WARNING: No audit log channel set. Infractions, raids, and account scoring alerts will not be visible to moderators. Configure one in the AUDIT tab.
            </div>
        }

        <EditForm Model="Form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="bw-sidebar-layout">
                <nav class="bw-sidebar-nav">
                    <div class="bw-sidebar-header font-mono">MODULES</div>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "general" ? "active" : "")" @onclick='() => _activeTab = "general"'>GENERAL</button>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "detection" ? "active" : "")" @onclick='() => _activeTab = "detection"'>DETECTION</button>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "links" ? "active" : "")" @onclick='() => _activeTab = "links"'>LINKS</button>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "contentguard" ? "active" : "")" @onclick='() => _activeTab = "contentguard"'>CONTENT GUARD</button>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "antiraid" ? "active" : "")" @onclick='() => _activeTab = "antiraid"'>ANTI-RAID</button>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "scoring" ? "active" : "")" @onclick='() => _activeTab = "scoring"'>SCORING</button>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "bans" ? "active" : "")" @onclick='() => _activeTab = "bans"'>BANS</button>
                    <button type="button" class="bw-sidebar-btn @(_activeTab == "audit" ? "active" : "")" @onclick='() => _activeTab = "audit"'>AUDIT</button>
                </nav>

                <div class="bw-sidebar-content">
                    @if (_activeTab == "general") {
                        <GeneralTab Form="Form" DiscordGuildId="DiscordGuildId" IsLockedDown="_isLockedDown" LockdownBusy="_lockdownBusy"
                                    OnLockdown="LockdownAsync" OnUnlock="UnlockAsync" OnError="HandleError" />
                    }
                    @if (_activeTab == "detection") {
                        <DetectionTab Form="Form" />
                    }
                    @if (_activeTab == "links") {
                        <LinksTab Form="Form" DiscordGuildId="DiscordGuildId" OnError="HandleError" />
                    }
                    @if (_activeTab == "contentguard") {
                        <ContentGuardTab Form="Form" DiscordGuildId="DiscordGuildId" OnError="HandleError" />
                    }
                    @if (_activeTab == "antiraid") {
                        <AntiRaidTab Form="Form" />
                    }
                    @if (_activeTab == "scoring") {
                        <ScoringTab Form="Form" />
                    }
                    @if (_activeTab == "bans") {
                        <BansTab DiscordGuildId="DiscordGuildId" InitialShareBanList="@_settings.ShareBanList" OnError="HandleError" />
                    }
                    @if (_activeTab == "audit") {
                        <AuditTab Form="Form" DiscordGuildId="DiscordGuildId" />
                    }

                    <div class="d-flex align-items-center gap-3 mt-2">
                        <button type="submit" class="btn btn-primary cut-corner font-display bw-btn-md">
                            COMMIT CHANGES
                        </button>
                        <a href="/dashboard" class="btn btn-outline-secondary font-display bw-btn-md">
                            CANCEL
                        </a>
                    </div>
                </div>
            </div>
        </EditForm>

        <hr style="border-color:var(--bw-danger);opacity:0.25;margin:3rem 0 2rem" />

        <div class="cut-corner border mb-4 bw-card-danger">
            <div class="card-header bw-header-danger">DANGER ZONE</div>
            <div class="p-4">
                <p class="font-mono mb-4 bw-desc">
                    Removing the bot will immediately kick it from your Discord server and deactivate this Blackwall instance. Your configuration will be preserved if you re-add the bot later.
                </p>

                @if (!_confirmRemove) {
                    <button type="button" class="btn btn-outline-danger cut-corner font-display bw-btn-md"
                            @onclick="() => _confirmRemove = true">
                        REMOVE BOT FROM SERVER
                    </button>
                } else {
                    <div class="font-mono mb-3" style="font-size:0.8rem;color:var(--bw-danger)">
                        // WARNING: This will kick the bot from @_settings.Name. Are you sure?
                    </div>
                    <div class="d-flex gap-3">
                        <button type="button" class="btn btn-danger cut-corner font-display bw-btn-md"
                                disabled="@_removing"
                                @onclick="RemoveBotAsync">
                            @(_removing ? "REMOVING..." : "CONFIRM REMOVAL")
                        </button>
                        <button type="button" class="btn btn-outline-secondary font-display bw-btn-md"
                                @onclick="() => _confirmRemove = false">
                            ABORT
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long DiscordGuildId { get; set; }

    private GuildSettingsResponse? _settings;
    private bool _loading = true;
    private bool _saved;
    private string? _error;
    private bool _confirmRemove;
    private bool _removing;
    private string _activeTab = "general";

    private SpamConfigForm Form { get; set; } = new();
    private bool _isLockedDown;
    private bool _lockdownBusy;

    protected override async Task OnInitializedAsync() {
        try {
            _settings = await Api.GetGuildSettingsAsync(DiscordGuildId);

            if (_settings is not null) {
                var s = _settings.SpamConfiguration;
                Form.MaxMessagesPerWindow = s.MaxMessagesPerWindow;
                Form.RateLimitWindowSeconds = s.RateLimitWindowSeconds;
                Form.DuplicateMessageThreshold = s.DuplicateMessageThreshold;
                Form.DuplicateWindowSeconds = s.DuplicateWindowSeconds;
                Form.DuplicateCrossChannelEnabled = s.DuplicateCrossChannelEnabled;
                Form.MentionLimit = s.MentionLimit;
                Form.BlockInviteLinks = s.BlockInviteLinks;
                Form.BlockSuspiciousLinks = s.BlockSuspiciousLinks;
                Form.LinkWhitelistMode = s.LinkWhitelistMode;
                Form.SafeBrowsingEnabled = s.SafeBrowsingEnabled;
                Form.SafeBrowsingBlockUnsure = s.SafeBrowsingBlockUnsure;
                Form.IsEnabled = s.IsEnabled;
                Form.IsDryRun = s.IsDryRun;
                Form.IsTestMode = false;
                Form.LogChannelId = s.LogChannelId.HasValue ? s.LogChannelId.Value.ToString() : "";
                Form.IsAntiRaidEnabled = s.IsAntiRaidEnabled;
                Form.AntiRaidJoinThreshold = s.AntiRaidJoinThreshold;
                Form.AntiRaidWindowSeconds = s.AntiRaidWindowSeconds;
                Form.AntiRaidCooldownMinutes = s.AntiRaidCooldownMinutes;
                Form.IsAccountScoringEnabled = s.IsAccountScoringEnabled;
                Form.AutoTimeoutMediumRiskOnJoin = s.AutoTimeoutMediumRiskOnJoin;
                Form.AutoTimeoutHighRiskOnJoin = s.AutoTimeoutHighRiskOnJoin;
                Form.AccountScoringTimeoutMinutes = s.AccountScoringTimeoutMinutes;
                Form.RateLimitAction = s.RateLimitAction;
                Form.RateLimitAutoLockdown = s.RateLimitAutoLockdown;
                Form.RateLimitTimeoutMinutes = s.RateLimitTimeoutMinutes;
                Form.RateLimitMessageDeleteDays = s.RateLimitMessageDeleteDays;
                Form.DuplicateAction = s.DuplicateAction;
                Form.DuplicateAutoLockdown = s.DuplicateAutoLockdown;
                Form.DuplicateTimeoutMinutes = s.DuplicateTimeoutMinutes;
                Form.DuplicateMessageDeleteDays = s.DuplicateMessageDeleteDays;
                Form.MentionLimitAction = s.MentionLimitAction;
                Form.MentionLimitAutoLockdown = s.MentionLimitAutoLockdown;
                Form.MentionLimitTimeoutMinutes = s.MentionLimitTimeoutMinutes;
                Form.MentionLimitMessageDeleteDays = s.MentionLimitMessageDeleteDays;
                Form.InviteLinkAction = s.InviteLinkAction;
                Form.InviteLinkAutoLockdown = s.InviteLinkAutoLockdown;
                Form.InviteLinkTimeoutMinutes = s.InviteLinkTimeoutMinutes;
                Form.InviteLinkMessageDeleteDays = s.InviteLinkMessageDeleteDays;
                Form.SuspiciousLinkAction = s.SuspiciousLinkAction;
                Form.SuspiciousLinkAutoLockdown = s.SuspiciousLinkAutoLockdown;
                Form.SuspiciousLinkTimeoutMinutes = s.SuspiciousLinkTimeoutMinutes;
                Form.SuspiciousLinkMessageDeleteDays = s.SuspiciousLinkMessageDeleteDays;
                Form.IsContentGuardEnabled = s.IsContentGuardEnabled;
                Form.ContentGuardFuzzyMatching = s.ContentGuardFuzzyMatching;
                Form.ContentGuardInvisibleCharScrubbing = s.ContentGuardInvisibleCharScrubbing;
                Form.ContentGuardZalgoBlocking = s.ContentGuardZalgoBlocking;
                Form.ContentGuardCopypastaHashing = s.ContentGuardCopypastaHashing;
                Form.ContentGuardFuzzyThreshold = s.ContentGuardFuzzyThreshold;
                Form.ContentGuardZalgoMaxCombining = s.ContentGuardZalgoMaxCombining;
                Form.ContentGuardCopypastaMinLength = s.ContentGuardCopypastaMinLength;
                Form.ContentGuardCopypastaThreshold = s.ContentGuardCopypastaThreshold;
                Form.ContentGuardCopypastaWindowSeconds = s.ContentGuardCopypastaWindowSeconds;
                Form.ContentGuardAction = s.ContentGuardAction;
                Form.ContentGuardAutoLockdown = s.ContentGuardAutoLockdown;
                Form.ContentGuardTimeoutMinutes = s.ContentGuardTimeoutMinutes;
                Form.ContentGuardMessageDeleteDays = s.ContentGuardMessageDeleteDays;
                _isLockedDown = s.IsLockedDown;
            }
        } catch {
            _settings = null;
        } finally {
            _loading = false;
        }
    }

    private void HandleError(string error) {
        _error = error;
    }

    private async Task SaveAsync() {
        _saved = false;
        _error = null;

        try {
            long? logChannelId = long.TryParse(Form.LogChannelId, out var parsed) ? parsed : null;

            await Api.UpdateGuildSettingsAsync(DiscordGuildId, new UpdateGuildSettingsRequest(
                Form.MaxMessagesPerWindow,
                Form.RateLimitWindowSeconds,
                Form.DuplicateMessageThreshold,
                Form.DuplicateWindowSeconds,
                Form.DuplicateCrossChannelEnabled,
                Form.MentionLimit,
                Form.BlockInviteLinks,
                Form.BlockSuspiciousLinks,
                Form.LinkWhitelistMode,
                Form.SafeBrowsingEnabled,
                Form.SafeBrowsingBlockUnsure,
                Form.IsEnabled,
                Form.IsDryRun,
                false,
                logChannelId,
                Form.IsAntiRaidEnabled,
                Form.AntiRaidJoinThreshold,
                Form.AntiRaidWindowSeconds,
                Form.AntiRaidCooldownMinutes,
                Form.IsAccountScoringEnabled,
                Form.AutoTimeoutMediumRiskOnJoin,
                Form.AutoTimeoutHighRiskOnJoin,
                Form.AccountScoringTimeoutMinutes,
                _isLockedDown,
                Form.RateLimitAction,
                Form.RateLimitAutoLockdown,
                Form.RateLimitTimeoutMinutes,
                Form.RateLimitMessageDeleteDays,
                Form.DuplicateAction,
                Form.DuplicateAutoLockdown,
                Form.DuplicateTimeoutMinutes,
                Form.DuplicateMessageDeleteDays,
                Form.MentionLimitAction,
                Form.MentionLimitAutoLockdown,
                Form.MentionLimitTimeoutMinutes,
                Form.MentionLimitMessageDeleteDays,
                Form.InviteLinkAction,
                Form.InviteLinkAutoLockdown,
                Form.InviteLinkTimeoutMinutes,
                Form.InviteLinkMessageDeleteDays,
                Form.SuspiciousLinkAction,
                Form.SuspiciousLinkAutoLockdown,
                Form.SuspiciousLinkTimeoutMinutes,
                Form.SuspiciousLinkMessageDeleteDays,
                Form.IsContentGuardEnabled,
                Form.ContentGuardFuzzyMatching,
                Form.ContentGuardInvisibleCharScrubbing,
                Form.ContentGuardZalgoBlocking,
                Form.ContentGuardCopypastaHashing,
                Form.ContentGuardFuzzyThreshold,
                Form.ContentGuardZalgoMaxCombining,
                Form.ContentGuardCopypastaMinLength,
                Form.ContentGuardCopypastaThreshold,
                Form.ContentGuardCopypastaWindowSeconds,
                Form.ContentGuardAction,
                Form.ContentGuardAutoLockdown,
                Form.ContentGuardTimeoutMinutes,
                Form.ContentGuardMessageDeleteDays
            ));
            _saved = true;
            _settings = await Api.GetGuildSettingsAsync(DiscordGuildId);
        } catch (Exception ex) {
            _error = $"Failed to save settings: {ex.Message}";
        }
    }

    private async Task RemoveBotAsync() {
        _removing = true;
        _error = null;

        try {
            await Api.RemoveBotAsync(DiscordGuildId);
            Nav.NavigateTo("/dashboard", forceLoad: true);
        } catch (Exception ex) {
            _error = $"Failed to remove bot: {ex.Message}";
            _confirmRemove = false;
        } finally {
            _removing = false;
        }
    }

    private async Task LockdownAsync() {
        _lockdownBusy = true;
        _error = null;

        try {
            await Api.LockdownAsync(DiscordGuildId);
            _settings = await Api.GetGuildSettingsAsync(DiscordGuildId);
            if (_settings is not null)
                _isLockedDown = _settings.SpamConfiguration.IsLockedDown;
        } catch (Exception ex) {
            _error = $"Failed to initiate lockdown: {ex.Message}";
        } finally {
            _lockdownBusy = false;
        }
    }

    private async Task UnlockAsync() {
        _lockdownBusy = true;
        _error = null;

        try {
            await Api.UnlockAsync(DiscordGuildId);
            _settings = await Api.GetGuildSettingsAsync(DiscordGuildId);
            if (_settings is not null)
                _isLockedDown = _settings.SpamConfiguration.IsLockedDown;
        } catch (Exception ex) {
            _error = $"Failed to lift lockdown: {ex.Message}";
        } finally {
            _lockdownBusy = false;
        }
    }
}
