@page "/guild/{DiscordGuildId:long}"
@attribute [Authorize]
@rendermode InteractiveServer
@using Blackwall.Core.Entities
@using Blackwall.Core.Configuration
@using Microsoft.Extensions.Options
@inject BlackwallApiService Api
@inject NavigationManager Nav
@inject IOptions<SafeBrowsingOptions> SafeBrowsingOptions

<PageTitle>@(_settings?.Name ?? "Config") — Blackwall</PageTitle>

<div style="max-width:760px;margin:0 auto;padding:2.5rem 1.5rem">
    @if (_loading) {
        <div class="font-mono" style="color:var(--bw-muted);font-size:0.85rem">&gt; Loading configuration...</div>
    } else if (_settings is null) {
        <div class="font-mono mb-4" style="color:var(--bw-danger);font-size:0.85rem">&gt; SIGNAL LOST: Guild not found or access denied.</div>
        <a href="/dashboard" class="btn btn-primary cut-corner font-display" style="font-size:0.72rem">RETURN TO GRID</a>
    } else {
        <a href="/dashboard" class="d-inline-flex align-items-center gap-2 mb-4 font-mono text-decoration-none"
           style="font-size:0.68rem;letter-spacing:0.12em;color:var(--bw-muted)">
            &#8592; BACK TO GRID
        </a>

        <div class="d-flex align-items-center gap-3 mb-5">
            <GuildAvatar Name="@_settings.Name" Icon="@_settings.IconHash" GuildId="@_settings.DiscordGuildId" />
            <div>
                <div class="font-mono mb-1" style="font-size:0.65rem;letter-spacing:0.15em;color:var(--bw-primary)">
                    // GUILD CONFIG &middot; @_settings.DiscordGuildId
                </div>
                <h1 class="font-display mb-0" style="font-size:1.8rem;letter-spacing:0.04em">@_settings.Name.ToUpperInvariant()</h1>
                <div class="font-mono mt-1" style="font-size:0.68rem;color:var(--bw-muted)">
                    @(_settings.IsActive ? "BARRIER ACTIVE" : "BARRIER OFFLINE")
                </div>
            </div>
        </div>

        @if (_saved) {
            <div class="alert alert-success font-mono mb-4" style="font-size:0.8rem">
                // CONFIGURATION UPLOADED SUCCESSFULLY
            </div>
        }
        @if (_error is not null) {
            <div class="alert alert-danger font-mono mb-4" style="font-size:0.8rem">
                // ERROR: @_error
            </div>
        }
        @if (string.IsNullOrWhiteSpace(Form.LogChannelId)) {
            <div class="bw-warning font-mono mb-4">
                // WARNING: No audit log channel set. Infractions, raids, and account scoring alerts will not be visible to moderators. Configure one in the AUDIT tab.
            </div>
        }

        <EditForm Model="Form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="bw-tabs">
                <button type="button" class="bw-tab-btn @(_activeTab == "general"   ? "active" : "")" @onclick='() => _activeTab = "general"'>GENERAL</button>
                <button type="button" class="bw-tab-btn @(_activeTab == "detection" ? "active" : "")" @onclick='() => _activeTab = "detection"'>DETECTION</button>
                <button type="button" class="bw-tab-btn @(_activeTab == "links"     ? "active" : "")" @onclick='() => _activeTab = "links"'>LINKS</button>
                <button type="button" class="bw-tab-btn @(_activeTab == "antiraid"  ? "active" : "")" @onclick='() => _activeTab = "antiraid"'>ANTI-RAID</button>
                <button type="button" class="bw-tab-btn @(_activeTab == "scoring"   ? "active" : "")" @onclick='() => _activeTab = "scoring"'>SCORING</button>
                <button type="button" class="bw-tab-btn @(_activeTab == "bans"      ? "active" : "")" @onclick='() => _activeTab = "bans"'>BANS</button>
                <button type="button" class="bw-tab-btn @(_activeTab == "audit"     ? "active" : "")" @onclick='() => _activeTab = "audit"'>AUDIT</button>
            </div>

            @if (_activeTab == "general") {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">BARRIER CONTROL</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Master controls for barrier activation and enforcement mode.</p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Enable barrier</div>
                                <div class="form-text">When off, the bot will not process any messages in this server.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="isEnabled" @bind-Value="Form.IsEnabled" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Dry run</div>
                                <div class="form-text">Detections are logged but no action is taken against the user.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="isDryRun" @bind-Value="Form.IsDryRun" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg);border-color:var(--bw-danger) !important">
                    <div class="card-header" style="color:var(--bw-danger)">LOCKDOWN</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            Instantly denies Send Messages, Send Messages in Threads, and Create Public Threads for @@everyone in every text channel and category via channel-specific permission overwrites. Higher-tier roles are unaffected. Use /lockdown or /unlock in Discord to toggle from chat.
                        </p>

                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Lockdown status</div>
                                <div class="form-text">
                                    @if (_isLockedDown) {
                                        <text><span style="color:var(--bw-danger);font-weight:600">LOCKDOWN ACTIVE</span> &mdash; @("@everyone") is denied Send Messages in all text channels.</text>
                                    } else {
                                        <text><span style="color:var(--bw-muted)">Inactive</span> &mdash; all channels are operating normally.</text>
                                    }
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                @if (_isLockedDown) {
                                    <button type="button" class="btn btn-outline-success cut-corner font-display"
                                            style="font-size:0.72rem;letter-spacing:0.1em"
                                            disabled="@_lockdownBusy"
                                            @onclick="UnlockAsync">
                                        @(_lockdownBusy ? "LIFTING..." : "LIFT LOCKDOWN")
                                    </button>
                                } else {
                                    <button type="button" class="btn btn-outline-danger cut-corner font-display"
                                            style="font-size:0.72rem;letter-spacing:0.1em"
                                            disabled="@_lockdownBusy"
                                            @onclick="LockdownAsync">
                                        @(_lockdownBusy ? "LOCKING..." : "INITIATE LOCKDOWN")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (_activeTab == "detection") {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">DETECTION MATRIX</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Controls how the barrier detects and neutralizes spam, duplicate floods, and mass-mention attacks. Each filter runs independently and stacks with the infraction action set in General.</p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Rate limit window (seconds)</div>
                                <div class="form-text">Rolling time window in which messages from a single user are counted. The counter resets once the window expires with no new messages.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.RateLimitWindowSeconds" />
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Max messages per window</div>
                                <div class="form-text">Maximum messages a user may send within the rate limit window. The next message after this limit triggers an infraction.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.MaxMessagesPerWindow" />
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Duplicate threshold</div>
                                <div class="form-text">Number of identical messages a user must send within the duplicate window before the filter trips. Set to 0 to disable duplicate detection.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.DuplicateMessageThreshold" />
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Duplicate window (seconds)</div>
                                <div class="form-text">How long identical message hashes are remembered per user. Shorter windows catch burst spam; longer windows catch slow repeated floods. Range: 1–300 s.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" min="1" max="300" @bind-Value="Form.DuplicateWindowSeconds" />
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Cross-channel duplicate detection</div>
                                <div class="form-text">When on, identical messages posted in different channels by the same user count toward the duplicate threshold. When off, duplicates are tracked per channel, so the same message repeated across channels will not trigger.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="dupCrossChannel" @bind-Value="Form.DuplicateCrossChannelEnabled" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>
                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Mention limit</div>
                                <div class="form-text">Maximum combined user, role, and @@everyone/@@here mentions allowed in a single message. Messages exceeding this are flagged as mass-ping spam.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.MentionLimit" />
                        </div>
                    </div>
                </div>

                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg);border-color:var(--bw-danger) !important">
                    <div class="card-header" style="color:var(--bw-danger)">MODULE ACTIONS</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Configure the action and lockdown behavior for each detection module independently.</p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Rate limit &mdash; action</div>
                                <div class="form-text">Action taken when a user exceeds the message rate limit.</div>
                            </div>
                            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.RateLimitAction">
                                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                                <option value="@InfractionAction.Timeout">Timeout</option>
                                <option value="@InfractionAction.Kick">Kick</option>
                                <option value="@InfractionAction.Ban">Ban</option>
                            </InputSelect>
                        </div>
                        @if (Form.RateLimitAction is InfractionAction.Timeout) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Rate limit &mdash; timeout (minutes)</div>
                                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.RateLimitTimeoutMinutes" />
                            </div>
                        }
                        @if (Form.RateLimitAction is InfractionAction.Ban) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Rate limit &mdash; delete messages (days)</div>
                                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.RateLimitMessageDeleteDays" />
                            </div>
                        }
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Rate limit &mdash; auto-lockdown</div>
                                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="rateLimitAutoLockdown" @bind-Value="Form.RateLimitAutoLockdown" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Duplicate &mdash; action</div>
                                <div class="form-text">Action taken when a user sends duplicate messages.</div>
                            </div>
                            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.DuplicateAction">
                                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                                <option value="@InfractionAction.Timeout">Timeout</option>
                                <option value="@InfractionAction.Kick">Kick</option>
                                <option value="@InfractionAction.Ban">Ban</option>
                            </InputSelect>
                        </div>
                        @if (Form.DuplicateAction is InfractionAction.Timeout) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Duplicate &mdash; timeout (minutes)</div>
                                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.DuplicateTimeoutMinutes" />
                            </div>
                        }
                        @if (Form.DuplicateAction is InfractionAction.Ban) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Duplicate &mdash; delete messages (days)</div>
                                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.DuplicateMessageDeleteDays" />
                            </div>
                        }
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Duplicate &mdash; auto-lockdown</div>
                                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="duplicateAutoLockdown" @bind-Value="Form.DuplicateAutoLockdown" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Mention limit &mdash; action</div>
                                <div class="form-text">Action taken when a user exceeds the mention limit.</div>
                            </div>
                            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.MentionLimitAction">
                                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                                <option value="@InfractionAction.Timeout">Timeout</option>
                                <option value="@InfractionAction.Kick">Kick</option>
                                <option value="@InfractionAction.Ban">Ban</option>
                            </InputSelect>
                        </div>
                        @if (Form.MentionLimitAction is InfractionAction.Timeout) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Mention limit &mdash; timeout (minutes)</div>
                                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.MentionLimitTimeoutMinutes" />
                            </div>
                        }
                        @if (Form.MentionLimitAction is InfractionAction.Ban) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Mention limit &mdash; delete messages (days)</div>
                                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.MentionLimitMessageDeleteDays" />
                            </div>
                        }
                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Mention limit &mdash; auto-lockdown</div>
                                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="mentionLimitAutoLockdown" @bind-Value="Form.MentionLimitAutoLockdown" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (_activeTab == "links") {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">LINK BLOCKING</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Configure which external vectors are neutralized automatically.</p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Block Discord invite links</div>
                                <div class="form-text">Deletes messages containing discord.gg invite URLs.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="blockInvites" @bind-Value="Form.BlockInviteLinks" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Block external links</div>
                                <div class="form-text">Checks message URLs against AdGuard blacklists and custom domains.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="blockSuspicious" @bind-Value="Form.BlockSuspiciousLinks" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>
                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Whitelist mode</div>
                                <div class="form-text">When on, blacklists are ignored and only domains in the custom domain list below are allowed. Everything else is blocked.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="linkWhitelist" @bind-Value="Form.LinkWhitelistMode" style="width:2.5em;height:1.3em" disabled="@(!Form.BlockSuspiciousLinks)" />
                            </div>
                        </div>
                    </div>
                </div>

                @if (SafeBrowsingOptions.Value.Enabled) {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">GOOGLE SAFE BROWSING</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Real-Time threat check powered by a locally synchronized Global Cache from Google Safe Browsing. All URL checks are resolved locally against the synced cache &mdash; no URL data or hash prefixes are ever sent to Google.</p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Enable Google Safe Browsing</div>
                                <div class="form-text">Checks URLs that pass the blacklist/whitelist filter against Google's threat lists in real-time.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="safeBrowsing" @bind-Value="Form.SafeBrowsingEnabled" style="width:2.5em;height:1.3em" disabled="@(!Form.BlockSuspiciousLinks)" />
                            </div>
                        </div>
                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Block level</div>
                                <div class="form-text">Choose which Safe Browsing results to block. <strong>Unsafe only</strong> blocks confirmed threats. <strong>Unsafe and Unsure</strong> also blocks URLs where the result is uncertain.</div>
                            </div>
                            <select class="form-select" style="max-width:250px" @bind="Form.SafeBrowsingBlockUnsure" disabled="@(!Form.SafeBrowsingEnabled)">
                                <option value="false">Unsafe only</option>
                                <option value="true">Unsafe and Unsure</option>
                            </select>
                        </div>
                    </div>
                </div>
                }

                @if (!Form.LinkWhitelistMode) {
                    <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                        <div class="card-header">BLACKLIST SOURCES</div>
                        <div class="p-4">
                            <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">AdGuard-format blacklist URLs. Domains from these lists are downloaded, merged, and cached in Redis. Refreshed daily.</p>

                            @if (_blacklists.Any()) {
                                <div class="mb-3">
                                    @foreach (var bl in _blacklists) {
                                        <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                                            <div class="font-mono text-break" style="font-size:0.75rem;color:var(--bw-muted)">@bl.Url</div>
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-2" style="font-size:0.7rem"
                                                    disabled="@_blacklistBusy"
                                                    @onclick="() => RemoveBlacklistAsync(bl.Id)">
                                                REMOVE
                                            </button>
                                        </div>
                                    }
                                </div>
                            } else {
                                <div class="font-mono mb-3" style="font-size:0.75rem;color:var(--bw-muted)">No blacklists configured.</div>
                            }

                            <div class="mb-3">
                                <label class="form-label font-mono" style="font-size:0.7rem;letter-spacing:0.1em">ADD FROM DEFAULTS</label>
                                <select class="form-select mb-2" @bind="_selectedDefaultBlacklist">
                                    <option value="">— Select a default blacklist —</option>
                                    @foreach (var def in _defaultBlacklists) {
                                        <option value="@def.Url">@def.Url</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary cut-corner font-display" style="font-size:0.7rem;letter-spacing:0.1em"
                                        disabled="@(string.IsNullOrWhiteSpace(_selectedDefaultBlacklist) || _blacklistBusy)"
                                        @onclick="AddDefaultBlacklistAsync">
                                    ADD SELECTED
                                </button>
                            </div>

                            <div>
                                <label class="form-label font-mono" style="font-size:0.7rem;letter-spacing:0.1em">ADD CUSTOM URL</label>
                                <div class="d-flex gap-2">
                                    <input type="url" class="form-control" placeholder="https://example.com/blocklist.txt"
                                           @bind="_newBlacklistUrl" disabled="@_blacklistBusy" />
                                    <button type="button" class="btn btn-outline-primary cut-corner font-display" style="font-size:0.7rem;letter-spacing:0.1em;white-space:nowrap"
                                            disabled="@(string.IsNullOrWhiteSpace(_newBlacklistUrl) || _blacklistBusy)"
                                            @onclick="AddCustomBlacklistAsync">
                                        ADD
                                    </button>
                                </div>
                            </div>

                            <div class="mt-3">
                                <button type="button" class="btn btn-outline-secondary cut-corner font-display" style="font-size:0.7rem;letter-spacing:0.1em"
                                        disabled="@_blacklistBusy"
                                        @onclick="RefreshBlacklistsAsync">
                                    @(_blacklistBusy ? "REFRESHING..." : "REFRESH NOW")
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">@(Form.LinkWhitelistMode ? "ALLOWED DOMAINS" : "CUSTOM BLOCKED DOMAINS")</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            @(Form.LinkWhitelistMode
                                ? "Only links to these domains will be allowed. All other external links are blocked."
                                : "Individual domains to block in addition to the blacklists above. Subdomains are matched automatically.")
                        </p>

                        @if (_blacklistDomains.Any()) {
                            <div class="mb-3">
                                @foreach (var dom in _blacklistDomains) {
                                    <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                                        <div class="font-mono" style="font-size:0.75rem">@dom.Domain</div>
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" style="font-size:0.7rem"
                                                disabled="@_blacklistBusy"
                                                @onclick="() => RemoveBlacklistDomainAsync(dom.Id)">
                                            REMOVE
                                        </button>
                                    </div>
                                }
                            </div>
                        } else {
                            <div class="font-mono mb-3" style="font-size:0.75rem;color:var(--bw-muted)">No custom domains configured.</div>
                        }

                        <div>
                            <label class="form-label font-mono" style="font-size:0.7rem;letter-spacing:0.1em">ADD DOMAIN</label>
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control" placeholder="example.com"
                                       @bind="_newDomain" disabled="@_blacklistBusy" />
                                <button type="button" class="btn btn-outline-primary cut-corner font-display" style="font-size:0.7rem;letter-spacing:0.1em;white-space:nowrap"
                                        disabled="@(string.IsNullOrWhiteSpace(_newDomain) || _blacklistBusy)"
                                        @onclick="AddBlacklistDomainAsync">
                                    ADD
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg);border-color:var(--bw-danger) !important">
                    <div class="card-header" style="color:var(--bw-danger)">MODULE ACTIONS</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Configure the action and lockdown behavior for each link protection module independently.</p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Invite link &mdash; action</div>
                                <div class="form-text">Action taken when a user posts a Discord invite link.</div>
                            </div>
                            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.InviteLinkAction">
                                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                                <option value="@InfractionAction.Timeout">Timeout</option>
                                <option value="@InfractionAction.Kick">Kick</option>
                                <option value="@InfractionAction.Ban">Ban</option>
                            </InputSelect>
                        </div>
                        @if (Form.InviteLinkAction is InfractionAction.Timeout) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Invite link &mdash; timeout (minutes)</div>
                                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.InviteLinkTimeoutMinutes" />
                            </div>
                        }
                        @if (Form.InviteLinkAction is InfractionAction.Ban) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">Invite link &mdash; delete messages (days)</div>
                                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.InviteLinkMessageDeleteDays" />
                            </div>
                        }
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Invite link &mdash; auto-lockdown</div>
                                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="inviteLinkAutoLockdown" @bind-Value="Form.InviteLinkAutoLockdown" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">External link &mdash; action</div>
                                <div class="form-text">Action taken when a user posts a blocked external link.</div>
                            </div>
                            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.SuspiciousLinkAction">
                                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                                <option value="@InfractionAction.Timeout">Timeout</option>
                                <option value="@InfractionAction.Kick">Kick</option>
                                <option value="@InfractionAction.Ban">Ban</option>
                            </InputSelect>
                        </div>
                        @if (Form.SuspiciousLinkAction is InfractionAction.Timeout) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">External link &mdash; timeout (minutes)</div>
                                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.SuspiciousLinkTimeoutMinutes" />
                            </div>
                        }
                        @if (Form.SuspiciousLinkAction is InfractionAction.Ban) {
                            <div class="bw-field">
                                <div class="bw-field-label">
                                    <div class="form-label mb-1">External link &mdash; delete messages (days)</div>
                                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                                </div>
                                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.SuspiciousLinkMessageDeleteDays" />
                            </div>
                        }
                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">External link &mdash; auto-lockdown</div>
                                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="suspiciousLinkAutoLockdown" @bind-Value="Form.SuspiciousLinkAutoLockdown" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (_activeTab == "antiraid") {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">ANTI-RAID</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            Automatically deletes all active invite links when an abnormal surge of joins is detected. During the cooldown period the action cannot re-trigger.
                        </p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Enable anti-raid</div>
                                <div class="form-text">Monitor join rate and automatically pause invites when a raid is detected.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="isAntiRaidEnabled" @bind-Value="Form.IsAntiRaidEnabled" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Join threshold</div>
                                <div class="form-text">Number of joins within the window that triggers the lockdown.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" min="2" @bind-Value="Form.AntiRaidJoinThreshold" disabled="@(!Form.IsAntiRaidEnabled)" />
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Detection window (seconds)</div>
                                <div class="form-text">Rolling time window used to count joins. Range: 5–300 s.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" min="5" max="300" @bind-Value="Form.AntiRaidWindowSeconds" disabled="@(!Form.IsAntiRaidEnabled)" />
                        </div>
                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Cooldown (minutes)</div>
                                <div class="form-text">How long invites remain paused before the lockdown lifts automatically.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.AntiRaidCooldownMinutes" disabled="@(!Form.IsAntiRaidEnabled)" />
                        </div>
                    </div>
                </div>

            }

            @if (_activeTab == "scoring") {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">ACCOUNT SCORING</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            Assigns a hidden threat score to users on join based on account age, profile picture, and username patterns. Medium and high risk accounts trigger a mod alert and can optionally be timed out automatically. Works independently of anti-raid.
                        </p>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Enable account scoring</div>
                                <div class="form-text">Evaluate joining users' account metadata and alert moderators for suspicious accounts.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="isAccountScoringEnabled" @bind-Value="Form.IsAccountScoringEnabled" style="width:2.5em;height:1.3em" />
                            </div>
                        </div>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Auto-timeout medium risk</div>
                                <div class="form-text">Automatically timeout medium-risk accounts on join. If disabled, mods are alerted only.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="autoTimeoutMediumRisk" @bind-Value="Form.AutoTimeoutMediumRiskOnJoin" style="width:2.5em;height:1.3em" disabled="@(!Form.IsAccountScoringEnabled)" />
                            </div>
                        </div>

                        <div class="bw-field">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Auto-timeout high risk</div>
                                <div class="form-text">Automatically timeout high-risk accounts on join. If disabled, mods are alerted only.</div>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" id="autoTimeoutHighRisk" @bind-Value="Form.AutoTimeoutHighRiskOnJoin" style="width:2.5em;height:1.3em" disabled="@(!Form.IsAccountScoringEnabled)" />
                            </div>
                        </div>

                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Timeout duration (minutes)</div>
                                <div class="form-text">How long the user is timed out when auto-timeout is triggered. Minimum: 1 minute.</div>
                            </div>
                            <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.AccountScoringTimeoutMinutes" disabled="@(!Form.IsAccountScoringEnabled)" />
                        </div>
                    </div>
                </div>
            }

            @if (_activeTab == "bans") {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">BAN LIST SHARING</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            When enabled, your server's ban list becomes visible to other servers managed by Blackwall. Other server admins can import your bans into their server. You control whether your bans are shared &mdash; importing is always available.
                        </p>

                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Share ban list</div>
                                <div class="form-text">When on, other Blackwall-managed servers can see and import your bans.</div>
                            </div>
                            <div class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" id="shareBanList" style="width:2.5em;height:1.3em"
                                       checked="@_shareBanList" disabled="@_banBusy" @onchange="ToggleShareBanListAsync" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">YOUR BAN LIST</div>
                    <div class="p-4">
                        <p class="font-mono mb-3" style="font-size:0.75rem;color:var(--bw-muted)">
                            @if (_bans.Any()) {
                                <text>@_bans.Count ban(s) synced. Sync now to pull the latest bans from Discord.</text>
                            } else {
                                <text>No bans synced yet. Click SYNC to pull the current ban list from Discord.</text>
                            }
                        </p>

                        <button type="button" class="btn btn-outline-primary cut-corner font-display mb-3" style="font-size:0.7rem;letter-spacing:0.1em"
                                disabled="@_banBusy" @onclick="SyncBansAsync">
                            @(_banBusy ? "SYNCING..." : "SYNC FROM DISCORD")
                        </button>

                        @if (_bans.Any()) {
                            <div style="max-height:400px;overflow-y:auto">
                                @foreach (var ban in _bans) {
                                    <div class="d-flex align-items-start justify-content-between border-bottom py-2">
                                        <div>
                                            <div class="font-mono" style="font-size:0.78rem">@(ban.Username ?? "Unknown") <span style="color:var(--bw-muted)">(@ban.DiscordUserId)</span></div>
                                            @if (!string.IsNullOrWhiteSpace(ban.Reason)) {
                                                <div class="font-mono" style="font-size:0.7rem;color:var(--bw-muted)">@ban.Reason</div>
                                            }
                                            @if (ban.BannedAtUtc.HasValue) {
                                                <div class="font-mono" style="font-size:0.68rem;color:var(--bw-muted)">@ban.BannedAtUtc.Value.ToString("yyyy-MM-dd HH:mm UTC")</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">IMPORT BANS</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            Import bans from other Blackwall-managed servers that have ban list sharing enabled. You can import the entire list or select individual bans. Users already banned in your server are automatically skipped.
                        </p>

                        @if (_sharedBanGuilds.Any()) {
                            <div class="mb-3">
                                <label class="form-label font-mono" style="font-size:0.7rem;letter-spacing:0.1em">SELECT SOURCE SERVER</label>
                                <select class="form-select mb-2" @bind="_selectedSourceGuildId" disabled="@_banBusy">
                                    <option value="0">— Select a server —</option>
                                    @foreach (var g in _sharedBanGuilds) {
                                        <option value="@g.DiscordGuildId">@g.Name (@g.BanCount bans)</option>
                                    }
                                </select>
                            </div>

                            @if (_selectedSourceGuildId > 0) {
                                <div class="mb-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <label class="form-label font-mono mb-0" style="font-size:0.7rem;letter-spacing:0.1em">SOURCE BANS</label>
                                        <button type="button" class="btn btn-sm btn-outline-secondary font-display" style="font-size:0.65rem;letter-spacing:0.1em"
                                                disabled="@_banBusy" @onclick="LoadSourceBansAsync">
                                            LOAD BANS
                                        </button>
                                    </div>

                                    @if (_sourceBans.Any()) {
                                        <div style="max-height:300px;overflow-y:auto;border:1px solid var(--bs-border-color);border-radius:0.25rem;padding:0.5rem">
                                            @foreach (var ban in _sourceBans) {
                                                <div class="d-flex align-items-center justify-content-between border-bottom py-1">
                                                    <div class="font-mono" style="font-size:0.72rem">
                                                        <input type="checkbox" class="form-check-input me-2"
                                                               id="ban-@ban.DiscordUserId"
                                                               checked="@_selectedImportUserIds.Contains(ban.DiscordUserId)"
                                                               @onchange="@(e => ToggleImportUser(ban.DiscordUserId, (bool?)e.Value))" />
                                                        <label for="ban-@ban.DiscordUserId">@(ban.Username ?? "Unknown") (@ban.DiscordUserId)</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="mt-2 d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary font-display" style="font-size:0.65rem;letter-spacing:0.1em"
                                                    disabled="@_banBusy" @onclick="SelectAllSourceBans">SELECT ALL</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary font-display" style="font-size:0.65rem;letter-spacing:0.1em"
                                                    disabled="@_banBusy" @onclick="ClearSelectedImportUsers">CLEAR</button>
                                        </div>
                                    } else if (_sourceBansLoaded) {
                                        <div class="font-mono" style="font-size:0.72rem;color:var(--bw-muted)">No bans found in source server.</div>
                                    }
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary cut-corner font-display" style="font-size:0.72rem;letter-spacing:0.1em"
                                            disabled="@(_banBusy || _selectedSourceGuildId == 0)"
                                            @onclick="ImportAllBansAsync">
                                        @(_banBusy ? "IMPORTING..." : "IMPORT ALL")
                                    </button>
                                    @if (_selectedImportUserIds.Count > 0) {
                                        <button type="button" class="btn btn-outline-primary cut-corner font-display" style="font-size:0.72rem;letter-spacing:0.1em"
                                                disabled="@_banBusy" @onclick="ImportSelectedBansAsync">
                                            @(_banBusy ? "IMPORTING..." : $"IMPORT SELECTED ({_selectedImportUserIds.Count})")
                                        </button>
                                    }
                                </div>
                            }
                        } else {
                            <div class="font-mono" style="font-size:0.75rem;color:var(--bw-muted)">No other servers have ban list sharing enabled.</div>
                        }

                        @if (_importResult is not null) {
                            <div class="alert alert-success font-mono my-4" style="font-size:0.8rem">
                                // IMPORT COMPLETE: @_importResult.Imported imported, @_importResult.Skipped skipped (already banned), @_importResult.Failed failed.
                                @if (_importResult.Errors.Count > 0) {
                                    <br />@string.Join("; ", _importResult.Errors.Take(5))
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">AUTO-SYNC</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            Automatically import bans from selected servers on a regular schedule. New bans added by the source server will be imported automatically. Users already banned in your server are skipped.
                        </p>

                        @if (_banSyncRules.Any()) {
                            <div class="mb-3">
                                @foreach (var rule in _banSyncRules) {
                                    <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                                        <div>
                                            <div class="font-mono" style="font-size:0.78rem">@rule.SourceGuildName <span style="color:var(--bw-muted)">(@rule.SourceDiscordGuildId)</span></div>
                                            @if (rule.LastSyncedAtUtc.HasValue) {
                                                <div class="font-mono" style="font-size:0.68rem;color:var(--bw-muted)">Last synced: @rule.LastSyncedAtUtc.Value.ToString("yyyy-MM-dd HH:mm UTC")</div>
                                            } else {
                                                <div class="font-mono" style="font-size:0.68rem;color:var(--bw-muted)">Not yet synced</div>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="form-check form-switch">
                                                <input type="checkbox" class="form-check-input" id="rule-@rule.Id" style="width:2em;height:1.05em"
                                                       checked="@rule.IsEnabled" disabled="@_banBusy"
                                                       @onchange="@(e => ToggleBanSyncRuleAsync(rule.Id, (bool)e.Value!))" />
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" style="font-size:0.7rem"
                                                    disabled="@_banBusy" @onclick="() => RemoveBanSyncRuleAsync(rule.Id)">
                                                REMOVE
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        } else {
                            <div class="font-mono mb-3" style="font-size:0.75rem;color:var(--bw-muted)">No auto-sync rules configured.</div>
                        }

                        @if (_sharedBanGuilds.Any()) {
                            <div>
                                <label class="form-label font-mono" style="font-size:0.7rem;letter-spacing:0.1em">ADD AUTO-SYNC SOURCE</label>
                                <div class="d-flex gap-2">
                                    <select class="form-select" @bind="_selectedAutoSyncSourceId" disabled="@_banBusy">
                                        <option value="0">— Select a server —</option>
                                        @foreach (var g in _sharedBanGuilds) {
                                            <option value="@g.DiscordGuildId">@g.Name (@g.BanCount bans)</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-primary cut-corner font-display" style="font-size:0.7rem;letter-spacing:0.1em;white-space:nowrap"
                                            disabled="@(_selectedAutoSyncSourceId == 0 || _banBusy)" @onclick="AddBanSyncRuleAsync">
                                        ADD
                                    </button>
                                </div>
                            </div>
                        } else {
                            <div class="font-mono" style="font-size:0.75rem;color:var(--bw-muted)">No shared ban lists available to auto-sync from.</div>
                        }
                    </div>
                </div>
            }

            @if (_activeTab == "audit") {
                <div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
                    <div class="card-header">AUDIT LOG</div>
                    <div class="p-4">
                        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                            Select a channel where Blackwall will post an embed for each infraction: who triggered it, which filter fired, the message content, and the action taken.
                        </p>

                        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
                            <div class="bw-field-label">
                                <div class="form-label mb-1">Log channel</div>
                                <div class="form-text">Leave blank to disable audit logging.</div>
                            </div>
                            <InputSelect class="form-select" style="max-width:260px" @bind-Value="Form.LogChannelId">
                                <option value="">— None —</option>
                                @foreach (var ch in _channels) {
                                    <option value="@ch.Id">#@ch.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex align-items-center gap-3 mt-2">
                <button type="submit" class="btn btn-primary cut-corner font-display" style="font-size:0.75rem;letter-spacing:0.1em">
                    COMMIT CHANGES
                </button>
                <a href="/dashboard" class="btn btn-outline-secondary font-display" style="font-size:0.75rem;letter-spacing:0.1em">
                    CANCEL
                </a>
            </div>
        </EditForm>

        <hr style="border-color:var(--bw-danger);opacity:0.25;margin:3rem 0 2rem" />

        <div class="cut-corner border mb-4" style="background:var(--bs-card-bg);border-color:var(--bw-danger) !important">
            <div class="card-header" style="color:var(--bw-danger)">DANGER ZONE</div>
            <div class="p-4">
                <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">
                    Removing the bot will immediately kick it from your Discord server and deactivate this Blackwall instance. Your configuration will be preserved if you re-add the bot later.
                </p>

                @if (!_confirmRemove) {
                    <button type="button" class="btn btn-outline-danger cut-corner font-display"
                            style="font-size:0.75rem;letter-spacing:0.1em"
                            @onclick="() => _confirmRemove = true">
                        REMOVE BOT FROM SERVER
                    </button>
                } else {
                    <div class="font-mono mb-3" style="font-size:0.8rem;color:var(--bw-danger)">
                        // WARNING: This will kick the bot from @_settings.Name. Are you sure?
                    </div>
                    <div class="d-flex gap-3">
                        <button type="button" class="btn btn-danger cut-corner font-display"
                                style="font-size:0.75rem;letter-spacing:0.1em"
                                disabled="@_removing"
                                @onclick="RemoveBotAsync">
                            @(_removing ? "REMOVING..." : "CONFIRM REMOVAL")
                        </button>
                        <button type="button" class="btn btn-outline-secondary font-display"
                                style="font-size:0.75rem;letter-spacing:0.1em"
                                @onclick="() => _confirmRemove = false">
                            ABORT
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

