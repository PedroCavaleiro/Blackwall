    private async Task AddDefaultBlacklistAsync() {
        if (string.IsNullOrWhiteSpace(_selectedDefaultBlacklist)) return;
        _blacklistBusy = true;
        _error = null;
        try {
            await Api.AddBlacklistAsync(DiscordGuildId, _selectedDefaultBlacklist);
            _blacklists = await Api.GetBlacklistsAsync(DiscordGuildId);
            _selectedDefaultBlacklist = "";
        } catch (Exception ex) {
            _error = $"Failed to add blacklist: {ex.Message}";
        } finally {
            _blacklistBusy = false;
        }
