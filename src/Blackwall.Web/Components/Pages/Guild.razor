    private async Task SaveAsync() {
        _saved = false;
        _error = null;

        try {
            long? logChannelId = long.TryParse(Form.LogChannelId, out var parsed) ? parsed : null;

            await Api.UpdateGuildSettingsAsync(DiscordGuildId, new UpdateGuildSettingsRequest(
                Form.MaxMessagesPerWindow,
                Form.RateLimitWindowSeconds,
                Form.DuplicateMessageThreshold,
                Form.DuplicateWindowSeconds,
                Form.DuplicateCrossChannelEnabled,
                Form.MentionLimit,
                Form.BlockInviteLinks,
                Form.BlockSuspiciousLinks,
                Form.LinkWhitelistMode,
                Form.SafeBrowsingEnabled,
                Form.SafeBrowsingBlockUnsure,
                Form.IsEnabled,
                Form.IsDryRun,
                logChannelId,
                Form.IsAntiRaidEnabled,
                Form.AntiRaidJoinThreshold,
                Form.AntiRaidWindowSeconds,
                Form.AntiRaidCooldownMinutes,
                Form.IsAccountScoringEnabled,
                Form.AutoTimeoutMediumRiskOnJoin,
                Form.AutoTimeoutHighRiskOnJoin,
                Form.AccountScoringTimeoutMinutes,
                _isLockedDown,
                Form.RateLimitAction,
                Form.RateLimitAutoLockdown,
                Form.RateLimitTimeoutMinutes,
                Form.RateLimitMessageDeleteDays,
                Form.DuplicateAction,
                Form.DuplicateAutoLockdown,
                Form.DuplicateTimeoutMinutes,
                Form.DuplicateMessageDeleteDays,
                Form.MentionLimitAction,
                Form.MentionLimitAutoLockdown,
                Form.MentionLimitTimeoutMinutes,
                Form.MentionLimitMessageDeleteDays,
                Form.InviteLinkAction,
                Form.InviteLinkAutoLockdown,
