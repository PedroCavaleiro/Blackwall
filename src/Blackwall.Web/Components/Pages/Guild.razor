                Form.SuspiciousLinkAction,
                Form.SuspiciousLinkAutoLockdown,
                Form.SuspiciousLinkTimeoutMinutes,
                Form.SuspiciousLinkMessageDeleteDays
            ));
            _saved = true;
            _settings = await Api.GetGuildSettingsAsync(DiscordGuildId);
