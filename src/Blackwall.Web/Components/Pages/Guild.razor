                _shareBanList = _settings.ShareBanList;
            }

            try {
                _bans = await Api.GetBansAsync(DiscordGuildId);
                _sharedBanGuilds = await Api.GetSharedBanListGuildsAsync(DiscordGuildId);
                _banSyncRules = await Api.GetBanSyncRulesAsync(DiscordGuildId);
            } catch {
                _bans = [];
                _sharedBanGuilds = [];
                _banSyncRules = [];
            }

            try {
                _blacklists = await Api.GetBlacklistsAsync(DiscordGuildId);
                _defaultBlacklists = await Api.GetDefaultBlacklistsAsync();
                _blacklistDomains = await Api.GetBlacklistDomainsAsync(DiscordGuildId);
            } catch {
                _blacklists = [];
                _defaultBlacklists = [];
                _blacklistDomains = [];
                _error = "Failed to load blacklist configuration.";
            }
        } catch {
            _settings = null;
        } finally {
            _loading = false;
