@page "/dashboard"
@attribute [Authorize]
@inject BlackwallApiService Api

<PageTitle>Grid — Blackwall</PageTitle>

<div style="max-width:1200px;margin:0 auto;padding:2.5rem 1.5rem">

    <div class="mb-5">
        <div class="font-mono mb-2" style="font-size:0.68rem;letter-spacing:0.18em;color:var(--bw-primary)">// GRID OVERVIEW</div>
        <h1 class="font-display mb-1" style="font-size:2.2rem;letter-spacing:0.04em">YOUR SERVERS</h1>
        <p class="font-mono mb-0" style="font-size:0.8rem;color:var(--bw-muted)">Servers where you hold MANAGE_GUILD authority.</p>
    </div>

    @if (_loading) {
        <div class="font-mono" style="color:var(--bw-muted);font-size:0.85rem">&gt; Scanning grid...</div>
    } else if (_guilds is null) {
        <div class="font-mono" style="color:var(--bw-danger);font-size:0.85rem">&gt; Connection error. Could not retrieve server list.</div>
    } else {
        <!-- DEPLOYED section -->
        <section class="mb-5">
            <div class="d-flex align-items-center gap-3 mb-3 font-mono" style="font-size:0.72rem;letter-spacing:0.15em">
                <span class="rounded-circle bw-pulse" style="width:7px;height:7px;background:var(--bw-success);flex-shrink:0;display:inline-block"></span>
                <span style="color:var(--bw-primary)">DEPLOYED</span>
                <span style="color:var(--bw-muted)">[<span>@_deployed.Count.ToString("D2")</span>]</span>
                <div class="flex-grow-1" style="height:1px;background:rgba(34,211,238,0.15)"></div>
            </div>
            @if (_deployed.Count == 0) {
                <div class="font-mono" style="border:1px dashed rgba(34,211,238,0.2);padding:2.5rem;text-align:center;font-size:0.8rem;color:var(--bw-muted)">&gt; No active deployments.</div>
            } else {
                <div class="row g-3">
                    @foreach (var guild in _deployed) {
                        <div class="col-sm-6 col-lg-4">
                            <a href="/guild/@guild.DiscordGuildId" class="bw-guild-card cut-corner d-block text-decoration-none">
                                <div class="d-flex align-items-start gap-3">
                                    <GuildAvatar Name="@guild.Name" Icon="@guild.Icon" GuildId="@guild.DiscordGuildId" />
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="font-display" style="font-size:0.95rem;letter-spacing:0.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@guild.Name</div>
                                        @if (guild.Owner) {
                                            <div class="font-mono mt-1" style="font-size:0.65rem;color:var(--bw-muted);letter-spacing:0.1em">OWNER</div>
                                        } else {
                                            <div class="font-mono mt-1" style="font-size:0.65rem;color:var(--bw-muted);letter-spacing:0.1em">MANAGER</div>
                                        }
                                        <div class="d-flex align-items-center gap-1 mt-2 font-mono" style="font-size:0.68rem;letter-spacing:0.12em">
                                            <span class="rounded-circle" style="width:5px;height:5px;background:var(--bw-success);display:inline-block"></span>
                                            <span style="color:var(--bw-success)">ACTIVE</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- AVAILABLE section -->
        <section>
            <div class="d-flex align-items-center gap-3 mb-3 font-mono" style="font-size:0.72rem;letter-spacing:0.15em">
                <span class="rounded-circle" style="width:7px;height:7px;background:var(--bw-muted);flex-shrink:0;display:inline-block"></span>
                <span style="color:var(--bw-primary)">AVAILABLE</span>
                <span style="color:var(--bw-muted)">[<span>@_available.Count.ToString("D2")</span>]</span>
                <div class="flex-grow-1" style="height:1px;background:rgba(34,211,238,0.15)"></div>
            </div>
            @if (_available.Count == 0) {
                <div class="font-mono" style="border:1px dashed rgba(34,211,238,0.2);padding:2.5rem;text-align:center;font-size:0.8rem;color:var(--bw-muted)">&gt; Every server you manage is protected.</div>
            } else {
                <div class="row g-3">
                    @foreach (var guild in _available) {
                        <div class="col-sm-6 col-lg-4">
                            <a href="/api/bot/invite?guildId=@guild.DiscordGuildId" class="bw-guild-card cut-corner d-block text-decoration-none">
                                <div class="d-flex align-items-start gap-3">
                                    <GuildAvatar Name="@guild.Name" Icon="@guild.Icon" GuildId="@guild.DiscordGuildId" />
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="font-display" style="font-size:0.95rem;letter-spacing:0.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@guild.Name</div>
                                        @if (guild.Owner) {
                                            <div class="font-mono mt-1" style="font-size:0.65rem;color:var(--bw-muted);letter-spacing:0.1em">OWNER</div>
                                        } else {
                                            <div class="font-mono mt-1" style="font-size:0.65rem;color:var(--bw-muted);letter-spacing:0.1em">MANAGER</div>
                                        }
                                        <div class="d-flex align-items-center gap-1 mt-2 font-mono" style="font-size:0.68rem;letter-spacing:0.12em">
                                            <span style="color:var(--bw-primary)">+ DEPLOY</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private IReadOnlyList<ManageableGuildResponse>? _guilds;
    private List<ManageableGuildResponse> _deployed  = [];
    private List<ManageableGuildResponse> _available = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() {
        try {
            _guilds = await Api.GetGuildsAsync();
            if (_guilds is not null) {
                _deployed  = _guilds.Where(g => g.BotInstalled).ToList();
                _available = _guilds.Where(g => !g.BotInstalled).ToList();
            }
        } catch {
            _guilds = null;
        } finally {
            _loading = false;
        }
    }
}
