@using Blackwall.Core.Entities
@using Blackwall.Core.Configuration
@using Microsoft.Extensions.Options
@inject BlackwallApiService Api
@inject IOptions<SafeBrowsingOptions> SafeBrowsingOptions

<div class="cut-corner border mb-4 bw-card">
    <div class="card-header">LINK BLOCKING</div>
    <div class="p-4">
        <p class="font-mono mb-4 bw-desc">Configure which external vectors are neutralized automatically.</p>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Block external links</div>
                <div class="form-text">Checks message URLs against AdGuard blacklists and custom domain rules.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input bw-switch" id="twitchBlockSuspicious" @bind-Value="Form.BlockSuspiciousLinks" />
            </div>
        </div>
        <div class="bw-field bw-field-last">
            <div class="bw-field-label">
                <div class="form-label mb-1">Whitelist mode</div>
                <div class="form-text">When on, blacklists are ignored and only domains in the domain rules list below are allowed. Everything else is blocked.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input bw-switch" id="twitchLinkWhitelist" @bind-Value="Form.LinkWhitelistMode" disabled="@(!Form.BlockSuspiciousLinks)" />
            </div>
        </div>
    </div>
</div>

@if (SafeBrowsingOptions.Value.Enabled) {
<div class="cut-corner border mb-4 bw-card">
    <div class="card-header">GOOGLE SAFE BROWSING</div>
    <div class="p-4">
        <p class="font-mono mb-4 bw-desc">Real-Time threat check powered by a locally synchronized Global Cache from Google Safe Browsing. All URL checks are resolved locally against the synced cache &mdash; no URL data or hash prefixes are ever sent to Google.</p>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Enable Google Safe Browsing</div>
                <div class="form-text">Checks URLs that pass the blacklist/whitelist filter against Google's threat lists in real-time.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input bw-switch" id="twitchSafeBrowsing" @bind-Value="Form.SafeBrowsingEnabled" disabled="@(!Form.BlockSuspiciousLinks)" />
            </div>
        </div>
        <div class="bw-field bw-field-last">
            <div class="bw-field-label">
                <div class="form-label mb-1">Block level</div>
                <div class="form-text">Choose which Safe Browsing results to block. <strong>Unsafe only</strong> blocks confirmed threats. <strong>Unsafe and Unsure</strong> also blocks URLs where the result is uncertain.</div>
            </div>
            <select class="form-select" style="max-width:250px" @bind="Form.SafeBrowsingBlockUnsure" disabled="@(!Form.SafeBrowsingEnabled)">
                <option value="false">Unsafe only</option>
                <option value="true">Unsafe and Unsure</option>
            </select>
        </div>
    </div>
</div>
}

@if (!Form.LinkWhitelistMode) {
    <div class="cut-corner border mb-4 bw-card">
        <div class="card-header">BLACKLIST SOURCES</div>
        <div class="p-4">
            <p class="font-mono mb-4 bw-desc">AdGuard-format blacklist URLs. Domains from these lists are downloaded, merged, and cached in Redis. Refreshed daily.</p>

            @if (_blacklists.Any()) {
                <div class="mb-3">
                    @foreach (var bl in _blacklists) {
                        <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                            <div class="font-mono text-break bw-desc">@bl.Url</div>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-2 bw-btn-remove"
                                    disabled="@_busy"
                                    @onclick="() => RemoveBlacklistAsync(bl.Id)">
                                REMOVE
                            </button>
                        </div>
                    }
                </div>
            } else {
                <div class="font-mono mb-3 bw-desc">No blacklists configured.</div>
            }

            <div class="mb-3">
                <label class="form-label font-mono bw-label">ADD FROM DEFAULTS</label>
                <select class="form-select mb-2" @bind="_selectedDefaultBlacklist">
                    <option value="">— Select a default blacklist —</option>
                    @foreach (var def in _defaultBlacklists) {
                        <option value="@def.Url">@def.Url</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-primary cut-corner font-display bw-btn-xs"
                        disabled="@(string.IsNullOrWhiteSpace(_selectedDefaultBlacklist) || _busy)"
                        @onclick="AddDefaultBlacklistAsync">
                    ADD SELECTED
                </button>
            </div>

            <div>
                <label class="form-label font-mono bw-label">ADD CUSTOM URL</label>
                <div class="d-flex gap-2">
                    <input type="url" class="form-control" placeholder="https://example.com/blocklist.txt"
                           @bind="_newBlacklistUrl" disabled="@_busy" />
                    <button type="button" class="btn btn-outline-primary cut-corner font-display bw-btn-xs-nowrap"
                            disabled="@(string.IsNullOrWhiteSpace(_newBlacklistUrl) || _busy)"
                            @onclick="AddCustomBlacklistAsync">
                        ADD
                    </button>
                </div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-outline-secondary cut-corner font-display bw-btn-xs"
                        disabled="@_busy"
                        @onclick="RefreshBlacklistsAsync">
                    @(_busy ? "REFRESHING..." : "REFRESH NOW")
                </button>
            </div>
        </div>
    </div>
}

<div class="cut-corner border mb-4 bw-card">
    <div class="card-header">@(Form.LinkWhitelistMode ? "ALLOWED DOMAIN RULES" : "BLOCKED DOMAIN RULES")</div>
    <div class="p-4">
        <p class="font-mono mb-4 bw-desc">
            @(Form.LinkWhitelistMode
                ? "Only links matching these rules will be allowed. All other links are blocked. Rules support path-level matching: entering twitch.tv allows all links from twitch, entering twitch.tv/moderator allows only moderator pages."
                : "Domain rules to block in addition to the blacklists above. Rules support path-level matching: entering twitch.tv blocks all links from twitch, entering twitch.tv/moderator blocks only moderator pages but allows other paths.")
        </p>

        @if (_domainRules.Any()) {
            <div class="mb-3">
                @foreach (var rule in _domainRules) {
                    <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                        <div class="font-mono" style="font-size:0.75rem">@rule.Rule</div>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-2 bw-btn-remove"
                                disabled="@_busy"
                                @onclick="() => RemoveDomainRuleAsync(rule.Id)">
                            REMOVE
                        </button>
                    </div>
                }
            </div>
        } else {
            <div class="font-mono mb-3 bw-desc">No domain rules configured.</div>
        }

        <div>
            <label class="form-label font-mono bw-label">ADD RULE</label>
            <div class="d-flex gap-2">
                <input type="text" class="form-control" placeholder="twitch.tv or twitch.tv/moderator"
                       @bind="_newRule" disabled="@_busy" />
                <button type="button" class="btn btn-outline-primary cut-corner font-display bw-btn-xs-nowrap"
                        disabled="@(string.IsNullOrWhiteSpace(_newRule) || _busy)"
                        @onclick="AddDomainRuleAsync">
                    ADD
                </button>
            </div>
        </div>
    </div>
</div>

<div class="cut-corner border mb-4 bw-card-danger">
    <div class="card-header bw-header-danger">MODULE ACTIONS</div>
    <div class="p-4">
        <p class="font-mono mb-4 bw-desc">Configure the action for link protection.</p>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">External link &mdash; action</div>
                <div class="form-text">Action taken when a user posts a blocked external link.</div>
            </div>
            <InputSelect class="form-select bw-input-select" @bind-Value="Form.SuspiciousLinkAction">
                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                <option value="@InfractionAction.Timeout">Timeout</option>
                <option value="@InfractionAction.Ban">Ban</option>
            </InputSelect>
        </div>
        @if (Form.SuspiciousLinkAction is InfractionAction.Timeout) {
            <div class="bw-field bw-field-last">
                <div class="bw-field-label">
                    <div class="form-label mb-1">External link &mdash; timeout (minutes)</div>
                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                </div>
                <InputNumber class="form-control bw-input-narrow" min="1" @bind-Value="Form.SuspiciousLinkTimeoutMinutes" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required TwitchChannelConfigForm Form { get; set; }
    [Parameter, EditorRequired] public required long TwitchUserId { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private IReadOnlyList<TwitchChannelBlacklistResponse> _blacklists = [];
    private IReadOnlyList<DefaultBlacklistResponse> _defaultBlacklists = [];
    private IReadOnlyList<TwitchChannelDomainRuleResponse> _domainRules = [];
    private string _selectedDefaultBlacklist = "";
    private string _newBlacklistUrl = "";
    private string _newRule = "";
    private bool _busy;

    protected override async Task OnInitializedAsync() {
        try {
            _blacklists = await Api.GetTwitchBlacklistsAsync(TwitchUserId);
            _defaultBlacklists = await Api.GetTwitchDefaultBlacklistsAsync();
            _domainRules = await Api.GetTwitchDomainRulesAsync(TwitchUserId);
        } catch {
            _blacklists = [];
            _defaultBlacklists = [];
            _domainRules = [];
            await OnError.InvokeAsync("Failed to load link configuration.");
        }
    }

    private async Task AddDefaultBlacklistAsync() {
        if (string.IsNullOrWhiteSpace(_selectedDefaultBlacklist)) return;
        _busy = true;
        try {
            await Api.AddTwitchBlacklistAsync(TwitchUserId, _selectedDefaultBlacklist);
            _blacklists = await Api.GetTwitchBlacklistsAsync(TwitchUserId);
            _selectedDefaultBlacklist = "";
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to add blacklist: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task AddCustomBlacklistAsync() {
        if (string.IsNullOrWhiteSpace(_newBlacklistUrl)) return;
        _busy = true;
        try {
            await Api.AddTwitchBlacklistAsync(TwitchUserId, _newBlacklistUrl);
            _blacklists = await Api.GetTwitchBlacklistsAsync(TwitchUserId);
            _newBlacklistUrl = "";
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to add blacklist: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task RemoveBlacklistAsync(long blacklistId) {
        _busy = true;
        try {
            await Api.RemoveTwitchBlacklistAsync(TwitchUserId, blacklistId);
            _blacklists = await Api.GetTwitchBlacklistsAsync(TwitchUserId);
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to remove blacklist: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task RefreshBlacklistsAsync() {
        _busy = true;
        try {
            await Api.RefreshTwitchBlacklistsAsync(TwitchUserId);
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to refresh blacklists: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task AddDomainRuleAsync() {
        if (string.IsNullOrWhiteSpace(_newRule)) return;
        _busy = true;
        try {
            await Api.AddTwitchDomainRuleAsync(TwitchUserId, _newRule);
            _domainRules = await Api.GetTwitchDomainRulesAsync(TwitchUserId);
            _newRule = "";
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to add domain rule: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task RemoveDomainRuleAsync(long ruleId) {
        _busy = true;
        try {
            await Api.RemoveTwitchDomainRuleAsync(TwitchUserId, ruleId);
            _domainRules = await Api.GetTwitchDomainRulesAsync(TwitchUserId);
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to remove domain rule: {ex.Message}");
        } finally {
            _busy = false;
        }
    }
}
