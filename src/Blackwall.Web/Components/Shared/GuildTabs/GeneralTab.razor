<div class="cut-corner border mb-4 bw-card">
    <div class="card-header">BARRIER CONTROL</div>
    <div class="p-4">
        <p class="font-mono mb-4 bw-desc">Master controls for barrier activation and enforcement mode.</p>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Enable barrier</div>
                <div class="form-text">When off, the bot will not process any messages in this server.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input bw-switch" id="isEnabled" @bind-Value="Form.IsEnabled" />
            </div>
        </div>
        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Dry run</div>
                <div class="form-text">Detections are logged but no action is taken against the user.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input bw-switch" id="isDryRun" @bind-Value="Form.IsDryRun" />
            </div>
        </div>
    </div>
</div>

<div class="cut-corner border mb-4 bw-card-danger">
    <div class="card-header bw-header-danger">LOCKDOWN</div>
    <div class="p-4">
        <p class="font-mono mb-4 bw-desc">
            Instantly denies Send Messages, Send Messages in Threads, and Create Public Threads for @@everyone in every text channel and category via channel-specific permission overwrites. Higher-tier roles are unaffected. Use /lockdown or /unlock in Discord to toggle from chat.
        </p>

        <div class="bw-field bw-field-last">
            <div class="bw-field-label">
                <div class="form-label mb-1">Lockdown status</div>
                <div class="form-text">
                    @if (IsLockedDown) {
                        <text><span style="color:var(--bw-danger);font-weight:600">LOCKDOWN ACTIVE</span> &mdash; @("@everyone") is denied Send Messages in all text channels.</text>
                    } else {
                        <text><span style="color:var(--bw-muted)">Inactive</span> &mdash; all channels are operating normally.</text>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (IsLockedDown) {
                    <button type="button" class="btn btn-outline-success cut-corner font-display bw-btn-sm"
                            disabled="@LockdownBusy"
                            @onclick="OnUnlock">
                        @(LockdownBusy ? "LIFTING..." : "LIFT LOCKDOWN")
                    </button>
                } else {
                    <button type="button" class="btn btn-outline-danger cut-corner font-display bw-btn-sm"
                            disabled="@LockdownBusy"
                            @onclick="OnLockdown">
                        @(LockdownBusy ? "LOCKING..." : "INITIATE LOCKDOWN")
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required SpamConfigForm Form { get; set; }
    [Parameter] public bool IsLockedDown { get; set; }
    [Parameter] public bool LockdownBusy { get; set; }
    [Parameter] public EventCallback OnLockdown { get; set; }
    [Parameter] public EventCallback OnUnlock { get; set; }
}
