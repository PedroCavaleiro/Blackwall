@inject BlackwallApiService Api
@using Blackwall.Core.DTOs

<div class="cut-corner border mb-4 bw-card">
    <div class="card-header">MODULE STORE</div>
    <div class="p-4">
        <div class="d-flex gap-2 mb-3">
            <input type="text" class="form-control bw-input font-mono" placeholder="Search modules..."
                   value="@_storeSearch" @oninput="OnStoreSearchInput" disabled="@_storeLoading" />
            <button type="button" class="btn btn-outline-secondary cut-corner font-display bw-btn-sm"
                    disabled="@_storeLoading" @onclick="LoadStoreAsync">
                @(_storeLoading ? "..." : "SEARCH")
            </button>
            <button type="button" class="btn btn-outline-secondary cut-corner font-display bw-btn-sm"
                    disabled="@_storeLoading" @onclick="RefreshStoreAsync">
                REFRESH
            </button>
        </div>
        @if (_storeLoading) {
            <div class="font-mono bw-loading bw-typewriter">&gt; Loading store...</div>
        } else if (!_storeModules.Any()) {
            <p class="font-mono bw-desc">No modules found in the registry.</p>
        } else {
            <p class="font-mono mb-3 bw-desc">@_storeModules.Count module(s) available.</p>
            @foreach (var mod in _storeModules) {
                <div class="d-flex justify-content-between align-items-start py-3 border-bottom">
                    <div class="flex-grow-1 me-3">
                        <div class="font-display">@(mod.ReadableName ?? mod.Name)</div>
                        <div class="font-mono bw-meta mb-1">@mod.Name</div>
                        @if (mod.Description is not null) {
                            <div class="font-mono bw-desc" style="font-size:0.85em">@mod.Description</div>
                        }
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @if (mod.Author is not null) {
                                <span class="font-mono bw-meta" style="font-size:0.75rem">by @mod.Author</span>
                            }
                            @if (mod.Category is not null) {
                                <span class="font-mono bw-meta" style="font-size:0.75rem">[ @mod.Category ]</span>
                            }
                            @foreach (var tag in mod.Tags) {
                                <span class="font-mono bw-meta" style="font-size:0.75rem">#@tag</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary cut-corner font-display bw-btn-xs flex-shrink-0"
                            disabled="@_installingStoreModule"
                            @onclick="@(async () => await InstallFromStoreAsync(mod.GitUrl))">
                        INSTALL
                    </button>
                </div>
            }
        }
        @if (_storeError is not null) {
            <div class="alert alert-danger font-mono mt-3 bw-alert-text">@_storeError</div>
        }
    </div>
</div>

<div class="cut-corner border mb-4 bw-card">
    <div class="card-header">INSTALL MODULE</div>
    <div class="p-4">
        <p class="font-mono mb-3 bw-desc">
            Install a module from a public HTTPS Git repository. The repository must contain a <code>blackwall-module.json</code> manifest at the root and a <code>src/</code> directory with the module project.
        </p>
        <div class="d-flex gap-2">
            <input type="text" class="form-control bw-input font-mono" placeholder="https://github.com/user/blackwall-module.git"
                   value="@_gitUrl" @oninput="OnGitUrlInput" disabled="@_installing" />
            <button type="button" class="btn btn-primary cut-corner font-display bw-btn-sm"
                    disabled="@(_installing || string.IsNullOrWhiteSpace(_gitUrl))"
                    @onclick="InstallAsync">
                @(_installing ? "INSTALLING..." : "INSTALL")
            </button>
        </div>
        @if (_installError is not null) {
            <div class="alert alert-danger font-mono mt-3 bw-alert-text">@_installError</div>
        }
    </div>
</div>

@if (_loading) {
    <div class="font-mono bw-loading bw-typewriter">&gt; Loading modules...</div>
} else if (!_modules.Any()) {
    <div class="cut-corner border mb-4 bw-card">
        <div class="card-header">INSTALLED MODULES</div>
        <div class="p-4">
            <p class="font-mono bw-desc">No modules installed. Install a module above to extend Blackwall's capabilities. Each installed module gets its own tab in the sidebar.</p>
        </div>
    </div>
} else {
    <div class="cut-corner border mb-4 bw-card">
        <div class="card-header">INSTALLED MODULES</div>
        <div class="p-4">
            <p class="font-mono mb-3 bw-desc">
                @(_modules.Count) module(s) installed. Each module has its own tab in the sidebar for configuration.
            </p>
            @foreach (var module in _modules) {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <span class="font-display">@(module.ReadableName ?? module.ModuleName)</span>
                        <span class="font-mono bw-meta ms-2">@module.ModuleName@@@module.ModuleVersion</span>
                        @if (!module.IsEnabled && !string.IsNullOrEmpty(module.DisabledReason)) {
                            <div class="font-mono bw-alert-text text-danger mt-1" style="font-size: 0.85em;">
                                ⚠ @module.DisabledReason
                            </div>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input bw-switch"
                                   id="mod-enabled-@module.Id"
                                   checked="@module.IsEnabled"
                                   @onchange="@(e => ToggleEnabledAsync(module, (bool)e.Value!))" />
                        </div>
                        <button type="button" class="btn btn-outline-secondary cut-corner font-display bw-btn-xs"
                                @onclick="@(async () => await UpdateAsync(module))">
                            @(_updatingId == module.Id ? "UPDATING..." : "UPDATE")
                        </button>
                        <button type="button" class="btn btn-outline-danger cut-corner font-display bw-btn-xs"
                                @onclick="@(async () => await UninstallAsync(module))">
                            @(_uninstallingId == module.Id ? "REMOVING..." : "UNINSTALL")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public long DiscordGuildId { get; set; }
    [Parameter] public Action<string>? OnError { get; set; }
    [Parameter] public Action? OnModulesChanged { get; set; }

    private IReadOnlyList<GuildModuleInstallationDto> _modules = [];
    private bool _loading = true;
    private string _gitUrl { get; set; } = "";
    private bool _installing;
    private string? _installError;
    private long? _togglingId;
    private long? _uninstallingId;
    private long? _updatingId;

    private IReadOnlyList<ModuleRegistryEntryDto> _storeModules = [];
    private bool _storeLoading = true;
    private string _storeSearch { get; set; } = "";
    private bool _installingStoreModule;
    private string? _storeError;

    protected override async Task OnInitializedAsync() {
        try {
            _modules = await Api.GetModulesAsync(DiscordGuildId);
        } catch (Exception ex) {
            OnError?.Invoke($"Failed to load modules: {ex.Message}");
        } finally {
            _loading = false;
        }

        _ = LoadStoreAsync();
    }

    private async Task LoadStoreAsync() {
        _storeLoading = true;
        _storeError = null;
        try {
            _storeModules = await Api.GetModuleRegistryAsync(
                string.IsNullOrWhiteSpace(_storeSearch) ? null : _storeSearch,
                "discord");
        } catch (Exception ex) {
            _storeError = ex.Message;
        } finally {
            _storeLoading = false;
        }
    }

    private async Task RefreshStoreAsync() {
        try {
            await Api.RefreshModuleRegistryAsync();
        } catch { }
        await LoadStoreAsync();
    }

    private void OnStoreSearchInput(ChangeEventArgs e) {
        _storeSearch = e.Value?.ToString() ?? "";
    }

    private async Task InstallFromStoreAsync(string gitUrl) {
        _installingStoreModule = true;
        _storeError = null;
        try {
            await Api.InstallModuleAsync(DiscordGuildId, gitUrl);
            _modules = await Api.GetModulesAsync(DiscordGuildId);
            OnModulesChanged?.Invoke();
        } catch (Exception ex) {
            _storeError = ex.Message;
        } finally {
            _installingStoreModule = false;
        }
    }

    private void OnGitUrlInput(ChangeEventArgs e) {
        _gitUrl = e.Value?.ToString() ?? "";
    }

    private async Task InstallAsync() {
        _installing = true;
        _installError = null;
        try {
            await Api.InstallModuleAsync(DiscordGuildId, _gitUrl);
            _gitUrl = "";
            _modules = await Api.GetModulesAsync(DiscordGuildId);
            OnModulesChanged?.Invoke();
        } catch (Exception ex) {
            _installError = ex.Message;
        } finally {
            _installing = false;
        }
    }

    private async Task ToggleEnabledAsync(GuildModuleInstallationDto module, bool isEnabled) {
        _togglingId = module.Id;
        try {
            await Api.SetModuleEnabledAsync(DiscordGuildId, module.ModuleName, isEnabled);
            _modules = await Api.GetModulesAsync(DiscordGuildId);
            OnModulesChanged?.Invoke();
        } catch (Exception ex) {
            OnError?.Invoke($"Failed to toggle module: {ex.Message}");
        } finally {
            _togglingId = null;
        }
    }

    private async Task UninstallAsync(GuildModuleInstallationDto module) {
        _uninstallingId = module.Id;
        try {
            await Api.UninstallModuleAsync(DiscordGuildId, module.ModuleName);
            _modules = await Api.GetModulesAsync(DiscordGuildId);
            OnModulesChanged?.Invoke();
        } catch (Exception ex) {
            OnError?.Invoke($"Failed to uninstall module: {ex.Message}");
        } finally {
            _uninstallingId = null;
        }
    }

    private async Task UpdateAsync(GuildModuleInstallationDto module) {
        _updatingId = module.Id;
        try {
            await Api.UpdateModuleAsync(DiscordGuildId, module.ModuleName);
            _modules = await Api.GetModulesAsync(DiscordGuildId);
            OnModulesChanged?.Invoke();
        } catch (Exception ex) {
            OnError?.Invoke($"Failed to update module: {ex.Message}");
        } finally {
            _updatingId = null;
        }
    }
}
