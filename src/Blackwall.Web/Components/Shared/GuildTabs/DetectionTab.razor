@using Blackwall.Core.Entities

<div class="cut-corner border mb-4" style="background:var(--bs-card-bg)">
    <div class="card-header">DETECTION MATRIX</div>
    <div class="p-4">
        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Controls how the barrier detects and neutralizes spam, duplicate floods, and mass-mention attacks. Each filter runs independently and stacks with the infraction action set in General.</p>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Rate limit window (seconds)</div>
                <div class="form-text">Rolling time window in which messages from a single user are counted. The counter resets once the window expires with no new messages.</div>
            </div>
            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.RateLimitWindowSeconds" />
        </div>
        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Max messages per window</div>
                <div class="form-text">Maximum messages a user may send within the rate limit window. The next message after this limit triggers an infraction.</div>
            </div>
            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.MaxMessagesPerWindow" />
        </div>
        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Duplicate threshold</div>
                <div class="form-text">Number of identical messages a user must send within the duplicate window before the filter trips. Set to 0 to disable duplicate detection.</div>
            </div>
            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.DuplicateMessageThreshold" />
        </div>
        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Duplicate window (seconds)</div>
                <div class="form-text">How long identical message hashes are remembered per user. Shorter windows catch burst spam; longer windows catch slow repeated floods. Range: 1–300 s.</div>
            </div>
            <InputNumber class="form-control" style="max-width:140px" min="1" max="300" @bind-Value="Form.DuplicateWindowSeconds" />
        </div>
        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Cross-channel duplicate detection</div>
                <div class="form-text">When on, identical messages posted in different channels by the same user count toward the duplicate threshold. When off, duplicates are tracked per channel, so the same message repeated across channels will not trigger.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input" id="dupCrossChannel" @bind-Value="Form.DuplicateCrossChannelEnabled" style="width:2.5em;height:1.3em" />
            </div>
        </div>
        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
            <div class="bw-field-label">
                <div class="form-label mb-1">Mention limit</div>
                <div class="form-text">Maximum combined user, role, and @@everyone/@@here mentions allowed in a single message. Messages exceeding this are flagged as mass-ping spam.</div>
            </div>
            <InputNumber class="form-control" style="max-width:140px" @bind-Value="Form.MentionLimit" />
        </div>
    </div>
</div>

<div class="cut-corner border mb-4" style="background:var(--bs-card-bg);border-color:var(--bw-danger) !important">
    <div class="card-header" style="color:var(--bw-danger)">MODULE ACTIONS</div>
    <div class="p-4">
        <p class="font-mono mb-4" style="font-size:0.75rem;color:var(--bw-muted)">Configure the action and lockdown behavior for each detection module independently.</p>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Rate limit &mdash; action</div>
                <div class="form-text">Action taken when a user exceeds the message rate limit.</div>
            </div>
            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.RateLimitAction">
                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                <option value="@InfractionAction.Timeout">Timeout</option>
                <option value="@InfractionAction.Kick">Kick</option>
                <option value="@InfractionAction.Ban">Ban</option>
            </InputSelect>
        </div>
        @if (Form.RateLimitAction is InfractionAction.Timeout) {
            <div class="bw-field">
                <div class="bw-field-label">
                    <div class="form-label mb-1">Rate limit &mdash; timeout (minutes)</div>
                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                </div>
                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.RateLimitTimeoutMinutes" />
            </div>
        }
        @if (Form.RateLimitAction is InfractionAction.Ban) {
            <div class="bw-field">
                <div class="bw-field-label">
                    <div class="form-label mb-1">Rate limit &mdash; delete messages (days)</div>
                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                </div>
                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.RateLimitMessageDeleteDays" />
            </div>
        }
        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Rate limit &mdash; auto-lockdown</div>
                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input" id="rateLimitAutoLockdown" @bind-Value="Form.RateLimitAutoLockdown" style="width:2.5em;height:1.3em" />
            </div>
        </div>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Duplicate &mdash; action</div>
                <div class="form-text">Action taken when a user sends duplicate messages.</div>
            </div>
            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.DuplicateAction">
                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                <option value="@InfractionAction.Timeout">Timeout</option>
                <option value="@InfractionAction.Kick">Kick</option>
                <option value="@InfractionAction.Ban">Ban</option>
            </InputSelect>
        </div>
        @if (Form.DuplicateAction is InfractionAction.Timeout) {
            <div class="bw-field">
                <div class="bw-field-label">
                    <div class="form-label mb-1">Duplicate &mdash; timeout (minutes)</div>
                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                </div>
                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.DuplicateTimeoutMinutes" />
            </div>
        }
        @if (Form.DuplicateAction is InfractionAction.Ban) {
            <div class="bw-field">
                <div class="bw-field-label">
                    <div class="form-label mb-1">Duplicate &mdash; delete messages (days)</div>
                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                </div>
                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.DuplicateMessageDeleteDays" />
            </div>
        }
        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Duplicate &mdash; auto-lockdown</div>
                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input" id="duplicateAutoLockdown" @bind-Value="Form.DuplicateAutoLockdown" style="width:2.5em;height:1.3em" />
            </div>
        </div>

        <div class="bw-field">
            <div class="bw-field-label">
                <div class="form-label mb-1">Mention limit &mdash; action</div>
                <div class="form-text">Action taken when a user exceeds the mention limit.</div>
            </div>
            <InputSelect class="form-select" style="max-width:200px" @bind-Value="Form.MentionLimitAction">
                <option value="@InfractionAction.DeleteOnly">Delete only</option>
                <option value="@InfractionAction.Timeout">Timeout</option>
                <option value="@InfractionAction.Kick">Kick</option>
                <option value="@InfractionAction.Ban">Ban</option>
            </InputSelect>
        </div>
        @if (Form.MentionLimitAction is InfractionAction.Timeout) {
            <div class="bw-field">
                <div class="bw-field-label">
                    <div class="form-label mb-1">Mention limit &mdash; timeout (minutes)</div>
                    <div class="form-text">How long the user is timed out. Minimum: 1 minute.</div>
                </div>
                <InputNumber class="form-control" style="max-width:140px" min="1" @bind-Value="Form.MentionLimitTimeoutMinutes" />
            </div>
        }
        @if (Form.MentionLimitAction is InfractionAction.Ban) {
            <div class="bw-field">
                <div class="bw-field-label">
                    <div class="form-label mb-1">Mention limit &mdash; delete messages (days)</div>
                    <div class="form-text">Number of days of message history to purge when banning. Maximum is 7 days.</div>
                </div>
                <InputNumber class="form-control" style="max-width:140px" min="0" max="7" @bind-Value="Form.MentionLimitMessageDeleteDays" />
            </div>
        }
        <div class="bw-field" style="border-bottom:none;padding-bottom:0">
            <div class="bw-field-label">
                <div class="form-label mb-1">Mention limit &mdash; auto-lockdown</div>
                <div class="form-text">Whether to trigger a server lockdown when this module fires.</div>
            </div>
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input" id="mentionLimitAutoLockdown" @bind-Value="Form.MentionLimitAutoLockdown" style="width:2.5em;height:1.3em" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required SpamConfigForm Form { get; set; }
}
