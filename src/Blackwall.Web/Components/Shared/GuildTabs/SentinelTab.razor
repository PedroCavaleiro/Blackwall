@using Blackwall.Core.Entities
@inject BlackwallApiService Api

<div class="cut-corner border mb-4 bw-card">
    <div class="card-header">SENTINEL TRAP CHANNELS</div>
    <div class="p-4">
        <p class="font-mono mb-4 bw-desc">
            Sentinel channels are invisible traps. When a user sends a message in a designated trap channel, Blackwall instantly applies the configured action &mdash; no warnings, no escalation. These are designed to catch spam bots and raiders that blindly post across every channel. Real users should never see these channels; hide them from @@everyone and only leave them accessible to bots or as visible bait.
        </p>

        @if (_sentinels.Any()) {
            <div class="mb-3">
                @foreach (var s in _sentinels) {
                    <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                        <div class="font-mono" style="font-size:0.75rem;flex:1;min-width:0">
                            <span class="bw-text-primary">#@s.ChannelName</span>
                            <span class="bw-text-muted"> &mdash; @s.Action</span>
                            @if (!s.IsEnabled) {
                                <span class="bw-text-muted"> (disabled)</span>
                            }
                        </div>
                        <div class="d-flex gap-2 ms-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary cut-corner font-display bw-btn-xs-nowrap"
                                    disabled="@_busy"
                                    @onclick="() => ToggleSentinelAsync(s)">
                                @(s.IsEnabled ? "DISABLE" : "ENABLE")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger bw-btn-remove"
                                    disabled="@_busy"
                                    @onclick="() => RemoveSentinelAsync(s.Id)">
                                REMOVE
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-outline-danger cut-corner font-display bw-btn-xs-nowrap"
                        disabled="@_busy"
                        @onclick="RemoveAllSentinelsAsync">
                    REMOVE ALL
                </button>
            </div>
        } else {
            <div class="font-mono mb-3 bw-desc">No sentinel channels configured. Add a trap channel below to start catching bots.</div>
        }

        <div class="border-top pt-3">
            <label class="form-label font-mono bw-label">ADD TRAP CHANNEL</label>
            <div class="mb-2">
                <InputSelect class="form-select mb-2" @bind-Value="_newChannelId">
                    <option value="">— Select channel —</option>
                    @foreach (var ch in _channels) {
                        <option value="@ch.Id">#@ch.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-2">
                <label class="form-label font-mono bw-label" style="font-size:0.7rem">ACTION</label>
                <InputSelect class="form-select" @bind-Value="_newAction">
                    <option value="@SentinelAction.SoftBan">Soft ban (ban + unban)</option>
                    <option value="@SentinelAction.Ban">Ban</option>
                    <option value="@SentinelAction.Timeout">Timeout</option>
                    <option value="@SentinelAction.AssignRole">Assign role</option>
                </InputSelect>
            </div>
            @if (_newAction is SentinelAction.Timeout) {
                <div class="mb-2">
                    <label class="form-label font-mono bw-label" style="font-size:0.7rem">TIMEOUT (MINUTES)</label>
                    <InputNumber class="form-control bw-input-narrow" min="1" @bind-Value="_newTimeoutMinutes" />
                </div>
            }
            @if (_newAction is SentinelAction.SoftBan or SentinelAction.Ban) {
                <div class="mb-2">
                    <label class="form-label font-mono bw-label" style="font-size:0.7rem">DELETE MESSAGE HISTORY (DAYS, 0&ndash;7)</label>
                    <InputNumber class="form-control bw-input-narrow" min="0" max="7" @bind-Value="_newDeleteDays" />
                </div>
            }
            @if (_newAction is SentinelAction.AssignRole) {
                <div class="mb-2">
                    <label class="form-label font-mono bw-label" style="font-size:0.7rem">ROLE ID</label>
                    <input type="text" class="form-control" placeholder="Discord role ID (e.g. 123456789012345678)"
                           @bind="_newRoleId" disabled="@_busy" />
                </div>
            }
            <button type="button" class="btn btn-outline-primary cut-corner font-display bw-btn-xs-nowrap"
                    disabled="@(_newChannelId is null || _busy)"
                    @onclick="AddSentinelAsync">
                ADD TRAP
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required long DiscordGuildId { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private IReadOnlyList<DiscordChannelDto> _channels = [];
    private IReadOnlyList<SentinelChannelDto> _sentinels = [];
    private long? _newChannelId;
    private SentinelAction _newAction = SentinelAction.SoftBan;
    private int _newTimeoutMinutes = 60;
    private int _newDeleteDays = 1;
    private string _newRoleId = "";
    private bool _busy;

    protected override async Task OnInitializedAsync() {
        try {
            _channels = await Api.GetChannelsAsync(DiscordGuildId);
            _sentinels = await Api.GetSentinelChannelsAsync(DiscordGuildId);
        } catch {
            _channels = [];
            _sentinels = [];
        }
    }

    private async Task ReloadSentinelsAsync() {
        try {
            _sentinels = await Api.GetSentinelChannelsAsync(DiscordGuildId);
        } catch {
            // keep stale list
        }
    }

    private async Task AddSentinelAsync() {
        if (_newChannelId is null || _newChannelId <= 0)
            return;

        long? roleId = null;
        if (_newAction is SentinelAction.AssignRole) {
            if (!long.TryParse(_newRoleId.Trim(), out var parsedRoleId) || parsedRoleId <= 0) {
                await OnError.InvokeAsync("Invalid role ID. Must be a numeric Discord snowflake.");
                return;
            }
            roleId = parsedRoleId;
        }

        var channelName = _channels.FirstOrDefault(c => c.Id == _newChannelId)?.Name ?? "unknown";

        _busy = true;
        try {
            await Api.CreateSentinelChannelAsync(DiscordGuildId, new CreateSentinelChannelRequest(
                _newChannelId.Value,
                channelName,
                _newAction,
                _newTimeoutMinutes,
                _newDeleteDays,
                roleId
            ));
            await ReloadSentinelsAsync();
            _newChannelId = null;
            _newRoleId = "";
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to add trap channel: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task ToggleSentinelAsync(SentinelChannelDto s) {
        _busy = true;
        try {
            await Api.UpdateSentinelChannelAsync(DiscordGuildId, s.Id, new UpdateSentinelChannelRequest(
                s.Action,
                s.TimeoutMinutes,
                s.MessageDeleteDays,
                s.AssignRoleId,
                !s.IsEnabled
            ));
            await ReloadSentinelsAsync();
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to toggle sentinel: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task RemoveSentinelAsync(long sentinelId) {
        _busy = true;
        try {
            await Api.DeleteSentinelChannelAsync(DiscordGuildId, sentinelId);
            await ReloadSentinelsAsync();
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to remove sentinel: {ex.Message}");
        } finally {
            _busy = false;
        }
    }

    private async Task RemoveAllSentinelsAsync() {
        _busy = true;
        try {
            await Api.DeleteAllSentinelChannelsAsync(DiscordGuildId);
            await ReloadSentinelsAsync();
        } catch (Exception ex) {
            await OnError.InvokeAsync($"Failed to remove all sentinels: {ex.Message}");
        } finally {
            _busy = false;
        }
    }
}
