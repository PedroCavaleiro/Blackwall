FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/Blackwall.Core/Blackwall.Core.csproj  src/Blackwall.Core/
COPY src/Blackwall.Web/Blackwall.Web.csproj    src/Blackwall.Web/
RUN dotnet restore src/Blackwall.Web/Blackwall.Web.csproj

COPY src/ src/
RUN dotnet publish src/Blackwall.Web/Blackwall.Web.csproj \
    -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Blackwall.Web.dll"]
